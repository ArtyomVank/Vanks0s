#!/usr/bin/env bash
# композитор Delta — запуск настоящей сессии. Вызывается экраном входа
# (greetd, Delta) из delta-compositor.desktop или вручную с текстовой консоли.
#
# Журнал — в systemd (journalctl -t delta-compositor -b), а если его нет —
# в ~/.local/state/delta-compositor/session.log (прошлый — session.log.old).

export XDG_CURRENT_DESKTOP=Vanks:Delta
export XDG_SESSION_DESKTOP=vanks
export XDG_SESSION_TYPE=wayland
# графической сессии ещё нет: оболочка сама ведёт видеокарту и ввод
unset DISPLAY WAYLAND_DISPLAY

if command -v systemd-cat >/dev/null 2>&1 && [ -z "${DELTA_LOG_FILE:-}" ]; then
    exec > >(exec systemd-cat -t delta-compositor) 2>&1
else
    log_dir=${XDG_STATE_HOME:-$HOME/.local/state}/delta-compositor
    mkdir -p "${log_dir}"
    [ -f "${log_dir}/session.log" ] && mv -f "${log_dir}/session.log" "${log_dir}/session.log.old"
    exec >"${log_dir}/session.log" 2>&1
fi

# своя шина D-Bus на сессию, если её не дал экран входа
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- delta-compositor --backend tty "$@"
fi
exec delta-compositor --backend tty "$@"
