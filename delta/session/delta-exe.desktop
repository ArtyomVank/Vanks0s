[Desktop Entry]
Type=Application
Name=Windows Program Launcher
Name[ru]=Запуск программ Windows
Comment=Open .exe, .msi, .bat, .reg and .lnk files normally (Wine) or through Proton CachyOS
Comment[ru]=Открыть .exe, .msi, .bat, .reg и .lnk обычно (Wine) или через Proton CachyOS
Exec=delta-exe %f
Icon=wine
Terminal=false
NoDisplay=true
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/vnd.microsoft.portable-executable;application/x-msi;application/x-ms-shortcut;application/x-wine-extension-msp;application/x-bat;text/x-msdos-batch;text/x-ms-regedit;
StartupWMClass=delta-exe
