#%PAM-1.0
# Delta — /etc/pam.d/delta-lock: экран блокировки (lock/Lock.qml).
# Как «login», плюс gnome-keyring: верный пароль заодно открывает связку
# ключей. При «Входить без пароля» её больше нечем открыть — пароля при входе
# нет, и браузер после каждого включения просил «разблокировать связку».
# Модуль открывает её сразу, если служба связки уже запущена.

auth       include      login
auth       optional     pam_gnome_keyring.so

account    include      login
