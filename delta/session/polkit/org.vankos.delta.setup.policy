<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Delta: установка рекомендованного из помощника (pkexec delta-setup install …). -->
<policyconfig>
  <vendor>Vanks OS</vendor>
  <action id="org.vankos.delta.setup">
    <description>Install or remove software</description>
    <description xml:lang="ru">Установить или удалить программы и драйверы</description>
    <message>Authentication is required to install or remove software and drivers</message>
    <message xml:lang="ru">Чтобы установить или удалить программы и драйверы, нужен пароль администратора.</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/delta-setup</annotate>
  </action>
</policyconfig>
