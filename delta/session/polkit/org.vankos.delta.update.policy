<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Delta: установка обновлений из «Настроек» (pkexec delta-update apply). -->
<policyconfig>
  <vendor>Vanks OS</vendor>
  <action id="org.vankos.delta.update">
    <description>Install updates</description>
    <description xml:lang="ru">Установить обновления</description>
    <message>Authentication is required to install updates</message>
    <message xml:lang="ru">Чтобы установить обновления, нужен пароль администратора.</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/delta-update</annotate>
  </action>
</policyconfig>
