#!/usr/bin/env bash
# Delta · Настройки — какие приложения умеют открывать тип и какое выбрано.
#
#   mime-apps <mime> …        {"<mime>": {"default": "x.desktop", "apps": ["a.desktop", …]}, …}
#   mime-apps --terminals     {"default": "kitty.desktop", "apps": [...]}
#
# Источники: mimeinfo.cache и MimeType= в .desktop (пользовательские,
# системные, flatpak), выбор — `xdg-mime query default`. Только чтение.
set -u

dirs=("${XDG_DATA_HOME:-$HOME/.local/share}/applications" /var/lib/flatpak/exports/share/applications /usr/local/share/applications /usr/share/applications)

visible() { # скрытые и NoDisplay-записи не предлагаем
    local f
    for d in "${dirs[@]}"; do
        f=${d}/$1
        [ -f "${f}" ] || continue
        grep -qiE '^(NoDisplay|Hidden)=true' "${f}" && return 1
        return 0
    done
    return 1
}

if [ "${1:-}" = --terminals ]; then
    apps=$(for d in "${dirs[@]}"; do grep -lE '^Categories=.*TerminalEmulator' "${d}"/*.desktop 2>/dev/null; done \
        | xargs -r -n1 basename | awk '!s[$0]++' | while read -r a; do visible "${a}" && echo "${a}"; done)
    def=$(sed -n '/^[^#]/{p;q}' "${XDG_CONFIG_HOME:-$HOME/.config}/xdg-terminals.list" 2>/dev/null)
    jq -n --arg d "${def}" --arg a "${apps}" '{ default: $d, apps: ($a | split("\n") | map(select(length > 0))) }'
    exit 0
fi

for mime in "$@"; do
    apps=$(
        for d in "${dirs[@]}"; do
            sed -n "s|^${mime//\//\\/}=||p" "${d}/mimeinfo.cache" 2>/dev/null | tr ';' '\n'
            grep -lE "^MimeType=(.*;)?${mime//\//\\/}(;|$)" "${d}"/*.desktop 2>/dev/null | xargs -r -n1 basename
        done | sed '/^$/d' | awk '!s[$0]++' | while read -r a; do visible "${a}" && echo "${a}"; done
    )
    def=$(xdg-mime query default "${mime}" 2>/dev/null)
    jq -n --arg m "${mime}" --arg d "${def}" --arg a "${apps}" '{ ($m): { default: $d, apps: ($a | split("\n") | map(select(length > 0))) } }'
done | jq -s 'add // {}'
