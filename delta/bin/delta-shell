#!/usr/bin/env bash
# Delta — запуск оболочки (доки, виджеты, уведомления, блокировка).
#
#   delta-shell                запустить (или ничего не делать, если уже запущена)
#   delta-shell --restart      перезапустить
#   delta-shell ipc <...>      передать команду: delta-shell ipc call shell reload
#
# Оболочка работает под присмотром: если она упала или Hyprland отключил её
# («error in client communication» — зависла и не читала события), от стола
# оставался чёрный фон без панели и обоев. Теперь она запускается снова, а
# журнал упавшей копии сохраняется в ~/.local/state/delta/shell-crash.log.
# Закрыли намеренно (qs kill, --restart) или закрылся сам Hyprland — не трогаем.
set -u

DELTA_DATA=${DELTA_DATA:-/usr/share/delta}
# DELTA_SHELL_ENTRY — другой входной файл (отладка одного модуля: shell/dev-*.qml)
SHELL_DIR=${DELTA_SHELL_ENTRY:-${DELTA_SHELL_DIR:-${DELTA_DATA}/shell}}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/delta

case "${1:-}" in
    ipc)
        shift
        exec qs -p "${SHELL_DIR}" ipc "$@"
        ;;
    --restart)
        qs -p "${SHELL_DIR}" kill >/dev/null 2>&1 || true
        # прежняя копия закрывается не сразу — иначе новая с -n увидит её и выйдет
        for _ in $(seq 50); do
            qs -p "${SHELL_DIR}" list 2>&1 | grep -q "Process ID" || break
            sleep 0.1
        done
        ;;
    --watch)
        # сессия Wayland ещё жива?
        alive() { [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-wayland-0}" ]; }
        restarts=()
        while :; do
            started=$(date +%s)
            # -n: не запускать вторую копию поверх работающей (тогда выход 0)
            qs -p "${SHELL_DIR}" -n &
            pid=$!
            wait "${pid}"
            code=$?
            [ "${code}" -eq 0 ] && exit 0
            alive || exit 0
            sleep 0.5
            alive || exit 0
            now=$(date +%s)
            log=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickshell/by-pid/${pid}/log.qslog
            mkdir -p "${STATE}"
            {
                printf '=== %s: оболочка закрылась (код %s) через %s с после запуска\n' "$(date '+%F %T')" "${code}" "$((now - started))"
                [ -f "${log}" ] && qs log -t 300 "${log}" 2>&1 | sed 's/\x1b\[[0-9;]*m//g'
            } > "${STATE}/shell-crash.log"
            # падает сразу снова и снова — не крутимся вечно
            restarts=("${restarts[@]}" "${now}")
            recent=0
            for t in "${restarts[@]}"; do [ $((now - t)) -lt 60 ] && recent=$((recent + 1)); done
            [ "${recent}" -ge 5 ] && exit 1
        done
        ;;
esac

# присмотр уходит в фон: вызвавший (Hyprland, терминал) не ждёт
setsid -f "$0" --watch >/dev/null 2>&1 </dev/null
