#!/usr/bin/env bash
# Delta — запуск сессии. Вызывается экраном входа (greetd / wayland-sessions).
#
# 1. окружение для Wayland-приложений и порталов;
# 2. первый запуск: пустой ~/.config/delta/settings.json (умолчания подмешиваются);
# 3. generated.lua из настроек (его читает только Hyprland);
# 4. композитор Delta, а если он не поднялся или выбрана сессия
#    «Delta на Hyprland» (--hyprland) — Hyprland под сторожем start-hyprland.
set -u

# DELTA_BACKEND=hyprland — то же, что --hyprland (так запускает tools/delta-dev.sh)
BACKEND=${DELTA_BACKEND:-compositor}
[ "${1:-}" = --hyprland ] && BACKEND=hyprland
command -v delta-compositor >/dev/null || BACKEND=hyprland

export DELTA_DATA=${DELTA_DATA:-/usr/share/delta}
if [ "${BACKEND}" = hyprland ]; then
    export XDG_CURRENT_DESKTOP=Delta:Hyprland
else
    export XDG_CURRENT_DESKTOP=Delta
fi
export XDG_SESSION_DESKTOP=delta
export XDG_SESSION_TYPE=wayland

# Журнал Hyprland, оболочки и delta-apply — в журнал systemd, а не на экран:
# иначе между экраном входа и рабочим столом видна текстовая консоль
# с бегущим логом и курсором. Читать: journalctl --user -t delta-session
# (или journalctl -t delta-session). Вложенная сессия пишет как раньше.
if [ -z "${DELTA_NESTED:-}" ]; then
    # консоль, на которой стартует сессия: чистый чёрный экран без курсора
    [ -t 1 ] && printf '\033[2J\033[H\033[?25l'
    if command -v systemd-cat >/dev/null; then
        exec > >(exec systemd-cat -t delta-session) 2>&1
    else
        exec >/dev/null 2>&1
    fi
fi

CFG=${XDG_CONFIG_HOME:-$HOME/.config}/delta
mkdir -p "${CFG}/hypr"

# язык программ, выбранный в первой настройке (oobe пишет ~/.config/locale.conf)
LOCALE_CONF=${XDG_CONFIG_HOME:-$HOME/.config}/locale.conf
if [ -r "${LOCALE_CONF}" ]; then
    while IFS='=' read -r key value; do
        case ${key} in
            LANG|LANGUAGE|LC_MESSAGES) export "${key}=${value//\"/}" ;;
        esac
    done < "${LOCALE_CONF}"
fi

# состояние Delta: отметки разовых шагов, журналы перетаскивания
# (drag.log — от Hyprland, jelly.log — от оболочки; переживают перезагрузку)
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/delta
mkdir -p "${STATE}"

# .exe и .msi открывает delta-exe (обычно или через Proton CachyOS) — один
# раз, если обработчика нет или это Wine; свой выбор пользователя не трогаем
EXE_MARK=${STATE}/exe-mime
if [ ! -e "${EXE_MARK}" ] && command -v xdg-mime >/dev/null; then
    cur=$(xdg-mime query default application/x-ms-dos-executable 2>/dev/null)
    case "${cur}" in
        ""|wine.desktop|wine-*.desktop)
            xdg-mime default delta-exe.desktop application/x-ms-dos-executable application/x-msdownload \
                application/vnd.microsoft.portable-executable application/x-msi 2>/dev/null ;;
    esac
    : > "${EXE_MARK}"
fi
# ярлыки .lnk, .bat/.cmd и .reg — тоже им, как двойной щелчок в Windows (с 0.6.5)
EXE_MARK2=${STATE}/exe-mime2
if [ ! -e "${EXE_MARK2}" ] && command -v xdg-mime >/dev/null; then
    for t in application/x-ms-shortcut application/x-bat text/x-msdos-batch text/x-ms-regedit; do
        cur=$(xdg-mime query default "${t}" 2>/dev/null)
        case "${cur}" in ""|wine.desktop|wine-*.desktop) xdg-mime default delta-exe.desktop "${t}" 2>/dev/null ;; esac
    done
    : > "${EXE_MARK2}"
fi

# папки и архивы — «Файлы», видео — «Видео» Delta (с 1.9.3): один раз и только
# там, где своей программы нет или она уже удалена; выбор пользователя не трогаем
OWN_MARK=${STATE}/own-apps-mime
if [ ! -e "${OWN_MARK}" ] && command -v xdg-mime >/dev/null; then
    own_default() {  # ярлык, типы…
        local app=$1 t cur d have
        shift
        for t in "$@"; do
            cur=$(xdg-mime query default "${t}" 2>/dev/null)
            have=0
            # ярлык ищем везде, где их ищет система (и у Flatpak тоже)
            if [ -n "${cur}" ]; then
                local IFS=:
                for d in ${XDG_DATA_HOME:-$HOME/.local/share} ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
                    [ -e "${d}/applications/${cur}" ] && { have=1; break; }
                done
                unset IFS
            fi
            [ "${have}" = 1 ] || xdg-mime default "${app}" "${t}" 2>/dev/null
        done
    }
    own_default delta-files.desktop inode/directory application/zip application/x-7z-compressed application/vnd.rar \
        application/x-rar application/x-tar application/x-compressed-tar application/x-xz-compressed-tar \
        application/x-zstd-compressed-tar application/x-bzip2-compressed-tar application/x-cd-image
    own_default delta-video.desktop video/mp4 video/x-matroska video/webm video/x-msvideo video/quicktime \
        video/x-m4v video/mpeg video/mp2t video/ogg
    : > "${OWN_MARK}"
fi

# В файле пользователя — только его изменения: значения по умолчанию
# подмешивают Settings и delta-apply, поэтому новые умолчания доходят
# и до старых установок.
if [ ! -s "${CFG}/settings.json" ]; then
    printf '{ "version": 1 }\n' > "${CFG}/settings.json"
fi

# Плохие настройки не должны мешать входу: delta-apply сам оставляет
# прежний generated.lua, если новый не прошёл проверку.
delta-apply --no-reload || true

# Запуск композитора Delta. Hyprland берёт это окружение из hyprland.lua
# и generated.lua, у композитора таких файлов нет.
run_compositor() {
    export QT_QPA_PLATFORM="wayland;xcb" QT_WAYLAND_DISABLE_WINDOWDECORATION=1 QT_QPA_PLATFORMTHEME=qt6ct
    export GDK_BACKEND="wayland,x11,*" ELECTRON_OZONE_PLATFORM_HINT=auto
    local cursor size
    cursor=$(jq -r '.appearance.cursorTheme // empty' "${CFG}/settings.json" 2>/dev/null)
    size=$(jq -r '.appearance.cursorSize // empty' "${CFG}/settings.json" 2>/dev/null)
    export XCURSOR_THEME=${cursor:-Adwaita} XCURSOR_SIZE=${size:-24}
    # своя шина D-Bus на сессию, если её не дал экран входа
    local bus=()
    [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || ! command -v dbus-run-session >/dev/null || bus=(dbus-run-session --)
    "${bus[@]}" delta-compositor --backend "$1"
}

if [ -n "${DELTA_NESTED:-}" ] && [ "${BACKEND}" = compositor ]; then
    # отладка: композитор в окне внутри текущей сессии
    run_compositor winit
    exit
fi
if [ -n "${DELTA_NESTED:-}" ]; then
    # отладка: Hyprland в окне внутри текущей сессии, без сторожа
    exec Hyprland -c "${DELTA_DATA}/hypr/hyprland.lua"
fi

# Экран входа показывает тему, обои и аватар пользователя: обновляем копию
# в фоне (вход не ждёт; без greetd помощник просто ничего не делает).
if command -v delta-greeter-sync >/dev/null; then
    delta-greeter-sync -q </dev/null >/dev/null 2>&1 &
fi

if [ "${BACKEND}" = compositor ]; then
    # Не поднялся за несколько секунд (видеокарта, права на устройства) —
    # рабочий стол важнее: заходим в Hyprland, а не возвращаем на экран входа.
    started=${SECONDS}
    run_compositor tty
    code=$?
    [ "${code}" -eq 0 ] || [ $((SECONDS - started)) -ge 15 ] && exit "${code}"
    echo "композитор Delta завершился с кодом ${code} сразу после запуска — открываю Hyprland"
    export XDG_CURRENT_DESKTOP=Delta:Hyprland
fi
exec start-hyprland -- -c "${DELTA_DATA}/hypr/hyprland.lua"
