#!/usr/bin/env bash
# Delta — выход при автовходе: «Добро пожаловать» и экран блокировки вместо
# экрана входа.
#
#   pkexec delta-relogin       перед выходом из сессии (PowerActions «Выход»)
#
# greetd выполняет [initial_session] (автовход) только при первом запуске и
# отмечает это в runfile (/run/greetd.run). После выхода он показал бы экран
# входа, а у кого включён «Входить без пароля», ждут то же, что при включении
# компьютера: «Добро пожаловать», потом экран блокировки Delta. Поэтому, когда
# сессия закрылась и greetd запустил greeter (тот держит «Добро пожаловать»,
# пока есть /run/delta-relogin), greetd перезапускается без runfile — и снова
# входит сам. Сессия закрылась не до конца (выход отменили) — ничего не делаем.
#
# Права даёт polkit (org.vankos.delta.relogin, без пароля) — и только
# пользователю, для которого включён автовход.
#
# Проверка без root: DELTA_GREETD_CONFIG=… DELTA_RELOGIN_FLAG=… delta-relogin
# (под root переменные игнорируются — pkexec их и не передаёт).
set -euo pipefail

CONF=/etc/greetd/config.toml
FLAG=/run/delta-relogin
if [ "$(id -u)" != 0 ]; then
    CONF=${DELTA_GREETD_CONFIG:-${CONF}}
    FLAG=${DELTA_RELOGIN_FLAG:-${FLAG}}
fi

fail() { echo "delta-relogin: $*" >&2; exit 1; }

user=$(DELTA_GREETD_CONFIG=${CONF} delta-autologin status)
[ -n "${user}" ] || fail "автовход выключен"
[ "${PKEXEC_UID:-$(id -u)}" = "$(id -u "${user}")" ] || fail "автовход включён для другого пользователя"

runfile=$(sed -n 's/^[[:space:]]*runfile[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "${CONF}" | head -n1)
runfile=${runfile:-/run/greetd.run}

# сессии greeter'а сейчас (могут ещё закрываться после прошлого входа)
greeters() { loginctl list-sessions --no-legend 2>/dev/null | awk '$3 == "greeter" { print $1 }' | sort; }
before=$(greeters | tr '\n' ' ')

: >"${FLAG}"
chmod 644 "${FLAG}"
# отдельной службой: сессия вот-вот закроется вместе со всеми своими процессами
systemd-run --quiet --collect --unit="delta-relogin-$(date +%s%N)" /bin/sh -c '
    runfile=$1 flag=$2 before=" $3 "
    new() { loginctl list-sessions --no-legend 2>/dev/null | awk "\$3 == \"greeter\" { print \$1 }" |
            while read -r s; do case "${before}" in *" ${s} "*) ;; *) echo "${s}" ;; esac; done | grep -q .; }
    i=0
    while [ "${i}" -lt 150 ] && ! new; do sleep 0.1; i=$((i + 1)); done
    if new; then
        # greeter успел нарисовать «Добро пожаловать»
        sleep 1
        rm -f "${runfile}"
        systemctl restart greetd
    fi
    rm -f "${flag}"' sh "${runfile}" "${FLAG}" "${before}"
