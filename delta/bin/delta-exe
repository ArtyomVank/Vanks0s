#!/usr/bin/env bash
# Delta — запуск программ Windows (.exe, .msi, а ещё .bat/.cmd, .reg, .lnk —
# как двойной щелчок в Windows).
#
#   delta-exe <файл>                        открыть: спросить, как (окно выбора)
#   delta-exe --run normal <файл>           обычно — через Wine системы
#   delta-exe --run launcher <раннер> <файл>
#                                           через лаунчер: auto · proton:<папка> · wine
#   delta-exe --install <раннер> <файл> <имя>
#                                           установщик: программа ставится в префикс
#                                           <имя>, её ярлыки появляются в меню
#   delta-exe --app <префикс> <файл>        запуск установленной (из ярлыка в меню)
#   delta-exe --add-app <префикс> <файл> [название]
#                                           ярлык программы префикса в меню (Delta Box)
#   delta-exe --runners                     найденные Proton CachyOS, Wine, umu (JSON)
#   delta-exe --fetch                       скачать последний Proton CachyOS
#   delta-exe --manager                     «Программы Windows»: все префиксы, их
#                                           программы и раннеры (окно)
#   delta-exe --list                        то же для окна (JSON)
#   delta-exe --set-runner <префикс> <раннер> · --winecfg <префикс>
#   delta-exe --folder <префикс> · --remove <префикс>
#   delta-exe --uninstall-info <ярлык.desktop>   что удалится (JSON для окна)
#   delta-exe --uninstall <ярлык.desktop>        удалить программу: её папку в
#                                           C:, ярлыки, а если система Windows
#                                           была только её — и систему
#   delta-exe --tidy                        убрать ярлыки удалённых программ
#   delta-exe --deps <файл>                 какие библиотеки нужны игре (JSON
#                                           delta-pe и что уже стоит в префиксе)
#   delta-exe --proton         путь к самому свежему Proton CachyOS (для delta-games)
#
# Игре с steam_api*.dll нужен Steam. Игра из библиотеки Steam запускается
# через сам Steam (steam://rungameid). Остальным: Steam для Linux запускается,
# лаунчер ждёт входа в аккаунт, а Proton идёт напрямую с
# STEAM_COMPAT_CLIENT_INSTALL_PATH на него и номером игры (steam_appid.txt,
# иначе — игра с тем же названием из вашей библиотеки Steam). Steam не
# установлен — уведомление, как его поставить. Ссылки из программ (вход, «открыть сайт») открывает
# браузер системы: в каждом префиксе winebrowser настроен на delta-open-url
# (xdg-open без окружения Proton), а в контейнере umu — на xdg-open.
#
# «Авто» — самый свежий Proton CachyOS: из пакета proton-cachyos или скачанный
# с GitHub (CachyOS/proton-cachyos) в ~/.local/share/delta/proton. Префикс
# у каждой программы свой: ~/.local/share/delta/prefixes/<имя>.
# Запуск через umu-run (umu-launcher), без него — прямо через proton.
# Установщики — всегда прямо через proton и до конца (wineserver -w): многие
# запускают дочерний процесс и выходят, а контейнер umu убил бы его вместе с
# собой. Exe из уже существующего префикса (программа поставлена раньше —
# лаунчером или обычно, в ~/.wine) запускается в нём же, его раннером: в новом
# пустом префиксе ей не хватило бы библиотек, которые ставил установщик.
#
# Окно выбора можно выключить: «Настройки» → «Рекомендации» (exe.enabled);
# там же список программ, которые всегда открываются обычно (exe.excluded),
# и запомненные «Всегда так» (exe.always).
set -u

DELTA_DATA=${DELTA_DATA:-/usr/share/delta}
SHELL_DIR=${DELTA_SHELL_DIR:-${DELTA_DATA}/shell}
ENTRY=${DELTA_EXE_ENTRY:-${SHELL_DIR}/exe-app.qml}
MANAGER=${DELTA_EXE_MANAGER_ENTRY:-${SHELL_DIR}/exe-manager.qml}
CONFIG=${XDG_CONFIG_HOME:-${HOME}/.config}/delta/settings.json
DATA=${XDG_DATA_HOME:-${HOME}/.local/share}/delta
PROTONS=${DATA}/proton
PREFIXES=${DATA}/prefixes
APPS=${XDG_DATA_HOME:-${HOME}/.local/share}/applications
ICONS=${DATA}/icons
REPO=${DELTA_PROTON_REPO:-CachyOS/proton-cachyos}
STATE=${XDG_STATE_HOME:-${HOME}/.local/state}/delta
LOG=${STATE}/exe.log
export DELTA_DATA

say() { notify-send -a "Delta" -i applications-games "$@" 2>/dev/null || printf '%s\n' "$*" >&2; }

# для «Программ Windows»: запущенные exe ($1) в списке $2 — без повторов,
# последний наверху, не больше 30
remember() {
    [[ $1 == /* ]] || return 0
    mkdir -p "$(dirname -- "$2")"
    { printf '%s\n' "$1"; grep -vxF -- "$1" "$2" 2>/dev/null; } | head -n 30 >"$2.new" && mv "$2.new" "$2"
}

# журнал установок и запусков — последние ~2000 строк
trim_log() {
    [ "$(wc -l <"${LOG}" 2>/dev/null || echo 0)" -gt 4000 ] || return 0
    tail -n 2000 "${LOG}" >"${LOG}.new" && mv "${LOG}.new" "${LOG}"
}

# имя программы для настроек: файл без пути, строчными
key_of() { basename -- "$1" | tr '[:upper:]' '[:lower:]'; }

setting() {  # путь jq, значение по умолчанию (false — тоже значение, не пусто)
    local v=""
    [ -f "${CONFIG}" ] && v=$(jq -r "$1 | if . == null then empty else . end" "${CONFIG}" 2>/dev/null)
    printf '%s' "${v:-$2}"
}

# --- Proton CachyOS ---
# все найденные: «имя<TAB>папка», новые первыми
list_protons() {
    local dirs=(
        "${PROTONS}"
        /usr/share/steam/compatibilitytools.d
        "${HOME}/.steam/root/compatibilitytools.d"
        "${HOME}/.local/share/Steam/compatibilitytools.d"
    )
    local d p
    for d in "${dirs[@]}"; do
        [ -d "${d}" ] || continue
        for p in "${d}"/*; do
            [ -x "${p}/proton" ] || continue
            case "$(basename -- "${p}")" in *[Cc]achy*) ;; *) continue ;; esac
            printf '%s\t%s\n' "$(basename -- "${p}")" "${p}"
        done
    done | sort -t$'\t' -k1,1 -V -r | awk -F'\t' '!seen[$1]++'
}
latest_proton() { list_protons | head -n1 | cut -f2; }

# последний выпуск с GitHub: скачать, сверить sha256, распаковать
fetch_proton() {
    command -v curl >/dev/null && command -v jq >/dev/null || { say "Нет curl или jq"; return 1; }
    local info url name digest tmp
    info=$(curl -fsSL --max-time 20 -H 'Accept: application/vnd.github+json' \
        "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null |
        jq -r '[.assets[] | select(.name | test("x86_64\\.tar\\.(xz|gz|zst)$"))][0]
               | [.browser_download_url, .name, (.digest // "")] | @tsv' 2>/dev/null)
    url=$(printf '%s' "${info}" | cut -f1)
    name=$(printf '%s' "${info}" | cut -f2)
    digest=$(printf '%s' "${info}" | cut -f3)
    [ -n "${url}" ] && [ "${url}" != null ] || { say "Proton CachyOS" "Не удалось узнать последнюю версию — нет сети?"; return 1; }
    case "${name}" in */*|..*) return 1 ;; esac
    mkdir -p "${PROTONS}"
    tmp=$(mktemp -d "${PROTONS}/.dl.XXXXXX") || return 1
    say "Proton CachyOS" "Скачиваю ${name%%.tar.*}…"
    if ! curl -fL --retry 2 -o "${tmp}/${name}" "${url}"; then
        rm -rf "${tmp}"; say "Proton CachyOS" "Не удалось скачать"; return 1
    fi
    if [ -n "${digest}" ]; then
        if [ "$(sha256sum "${tmp}/${name}" | cut -d' ' -f1)" != "${digest#sha256:}" ]; then
            rm -rf "${tmp}"; say "Proton CachyOS" "Файл повреждён (не сошлась контрольная сумма)"; return 1
        fi
    fi
    if ! tar -xf "${tmp}/${name}" -C "${tmp}"; then
        rm -rf "${tmp}"; say "Proton CachyOS" "Не удалось распаковать"; return 1
    fi
    local dir
    dir=$(find "${tmp}" -mindepth 1 -maxdepth 1 -type d | head -n1)
    [ -n "${dir}" ] && [ -x "${dir}/proton" ] || { rm -rf "${tmp}"; return 1; }
    rm -rf "${PROTONS:?}/$(basename -- "${dir}")"
    mv "${dir}" "${PROTONS}/"
    rm -rf "${tmp}"
    say "Proton CachyOS" "$(basename -- "${dir}") готов"
    printf '%s\n' "${PROTONS}/$(basename -- "${dir}")"
}

runners_json() {
    local protons
    protons=$(list_protons | jq -R 'split("\t") | { name: .[0], path: .[1] }' | jq -s .)
    jq -n --argjson protons "${protons:-[]}" \
        --arg wine "$(command -v wine || true)" \
        --arg umu "$(command -v umu-run || true)" \
        '{ protons: $protons, wine: ($wine != ""), umu: ($umu != "") }'
}

# --- запуск ---
run_normal() {
    local root name
    if root=$(prefix_root "$1"); then
        # программа из префикса лаунчера — Wine системы его не знает
        if name=$(prefix_name "${root}"); then run_launcher "$(prefix_runner "${name}" auto)" "$1" "${name}"; fi
        run_in_wine_prefix "${root}" "$1"
    fi
    command -v wine >/dev/null || { say "Нет Wine" "Поставьте его: «Настройки» → «Рекомендации» → «Библиотеки»"; exit 1; }
    remember "$1" "${DATA}/normal"
    cd -- "$(dirname -- "$1")" || true
    open_args "$1"
    exec wine "${ARGS[@]}"
}

# --- Steam для Linux ---
steam_dir() {
    local d
    for d in "${HOME}/.local/share/Steam" "${HOME}/.steam/steam" "${HOME}/.steam/root"; do
        [ -f "${d}/linux64/steamclient.so" ] && { realpath -- "${d}"; return 0; }
    done
    return 1
}
# корень игры: в библиотеке Steam — папка в steamapps/common; у Unreal Engine
# настоящий exe лежит в <Игра>/Binaries/Win64, а Steamworks — в Engine/…
game_root() {
    local d r
    d=$(dirname -- "$1")
    if [[ ${d} == */steamapps/common/* ]]; then
        r=${d#*/steamapps/common/}
        printf '%s\n' "${d%%/steamapps/common/*}/steamapps/common/${r%%/*}"
        return 0
    fi
    case "${d,,}" in
        */binaries/win64|*/binaries/win32) d=$(dirname -- "$(dirname -- "$(dirname -- "${d}")")") ;;
    esac
    printf '%s\n' "${d}"
}
# игра со Steamworks: в её папке есть steam_api.dll / steam_api64.dll.
# Глубоко: у Unity — Игра_Data/Plugins/x86_64 (4 уровня), у Unreal Engine —
# Engine/Binaries/ThirdParty/Steamworks/Steamv1xx/Win64 (7)
wants_steam() { find "$(game_root "$1")" -maxdepth 7 -iname 'steam_api*.dll' -print -quit 2>/dev/null | grep -q .; }
# номер игры, поставленной самим Steam (steamapps/common/<папка>): её
# appmanifest_<номер>.acf
library_id() {
    local root lib dir m d
    root=$(game_root "$1")
    [[ ${root} == */steamapps/common/* ]] || return 0
    lib=${root%%/steamapps/common/*}/steamapps
    dir=${root#"${lib}"/common/}
    dir=${dir%%/*}
    for m in "${lib}"/appmanifest_*.acf; do
        [ -f "${m}" ] || continue
        d=$(sed -n 's/^[[:space:]]*"installdir"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/Ip' "${m}")
        [ "${d,,}" = "${dir,,}" ] && { basename -- "${m}" .acf | tr -dc '0-9'; return 0; }
    done
}
# номер игры в Steam: steam_appid.txt от разработчика, игра из библиотеки
# Steam — её appmanifest, иначе — игра с тем же названием, что и папка, из
# вашей библиотеки Steam (delta-games appid): без номера Steam не знает, что
# это за игра, и не пускает её
app_id() {
    local root f id
    root=$(game_root "$1")
    f=$(find "${root}" -maxdepth 4 -name steam_appid.txt -print -quit 2>/dev/null)
    if [ -n "${f}" ]; then tr -dc '0-9' <"${f}" | head -c 12; return 0; fi
    id=$(library_id "$1")
    [ -n "${id}" ] && { printf '%s\n' "${id}"; return 0; }
    command -v delta-games >/dev/null && delta-games appid "$(basename -- "${root}")" 2>/dev/null
}
# ~/.steam/root — ссылка на папку Steam: по ней Steam ищут Proton, umu,
# protontricks и лаунчеры игр. Прежний delta-exe, пока Steam не был
# установлен, создавал там пустую папку, и Steam потом клал ссылку внутрь
# неё (~/.steam/root/Steam) — Steam «не находился». Чиним, если в папке
# ничего, кроме этой ссылки.
fix_steam_root() {
    local root=${HOME}/.steam/root dir=$1 f
    [ -d "${root}" ] && [ ! -L "${root}" ] || return 0
    for f in "${root}"/* "${root}"/.[!.]*; do
        [ -e "${f}" ] || [ -L "${f}" ] || continue
        [ -L "${f}" ] && [ "$(basename -- "${f}")" = Steam ] || return 0
        rm -f -- "${f}"
    done
    rmdir -- "${root}" 2>/dev/null && ln -sfn -- "${dir}" "${root}"
}
# вошли ли в Steam: его журнал соединения кончается состоянием «Logged On»
# (а не выходом LogOff), и журнал свежее, чем запуск Steam
steam_logged_in() {
    local log=$1/logs/connection_log.txt last
    pgrep -x steam >/dev/null || return 1
    [ -f "${log}" ] || return 1
    [ "${HOME}/.steam/steam.pid" -nt "${log}" ] && return 1
    last=$(tail -n 40 -- "${log}" | grep -E '^\[[^]]*\] \[(Logged|Logging|Connecting|Disconnect)' | tail -n1)
    [[ ${last} == *"] [Logged On,"* && ${last} != *"LogOff("* ]]
}
# Steam запущен и в него вошли — иначе игра не подключится к Steam и
# закроется. Ждём до двух минут: вход бывает с паролем и кодом.
start_steam() {
    local dir=$1 i
    steam_logged_in "${dir}" && return 0
    command -v steam >/dev/null || return 1
    if ! pgrep -x steam >/dev/null; then
        say "Steam" "Запускаю Steam — игре он нужен"
        setsid -f steam -silent >/dev/null 2>&1 </dev/null
    fi
    for i in $(seq 120); do
        steam_logged_in "${dir}" && { sleep 2; return 0; }
        # через 10 с без входа — подсказать, что ждём именно его
        [ "${i}" -eq 10 ] && say "Войдите в Steam" "Игра запустится сразу после входа в аккаунт"
        sleep 1
    done
    return 0
}

# --- запуск через лаунчер ---
# Собирает команду в CMD (переменные — через env) для раннера $1, файла $2 и
# префикса $3; $4 = wait — ждать, пока в префиксе закончатся все процессы
# (установщики запускают настоящую установку отдельным процессом и выходят).
# DLL рядом с exe — первыми, как в Windows. Wine для части системных DLL
# (winmm, winhttp, version, dinput8, dxgi, d3d9…) берёт свои встроенные, и
# библиотеки, которые программа принесла с собой, не грузятся: моды
# (BepInEx — winhttp, ReShade — dxgi, ASI-загрузчики — dinput8/winmm),
# обёртки графики, свои сборки. Ядро Windows не трогаем.
local_dlls() {
    local f n names=()
    [[ $1 == /* ]] || return 0
    for f in "$(dirname -- "$1")"/*.[dD][lL][lL]; do
        [ -f "${f}" ] || continue
        n=$(basename -- "${f}"); n=${n%.*}; n=${n,,}
        [[ ${n} =~ ^[a-z0-9_]+$ ]] || continue
        case "${n}" in
            kernel32|kernelbase|ntdll|user32|gdi32|win32u|advapi32|sechost|ole32|oleaut32|combase|rpcrt4|shell32|ucrtbase|msvcrt|ws2_32|crypt32|bcrypt|setupapi|wow64*) continue ;;
        esac
        names+=("${n}")
        [ "${#names[@]}" -ge 48 ] && break
    done
    [ "${#names[@]}" -gt 0 ] || return 0
    local IFS=,
    printf '%s=n,b' "${names[*]}"
}

# путь Linux для программы Windows: Z:\home\…
win_path() { local p=${1//\//\\}; printf 'Z:%s\n' "${p}"; }
# Не всё, что открывается в Windows двойным щелчком, — программа: .msi
# открывает msiexec, .bat/.cmd — cmd, .reg — regedit (путь — на диске Z:,
# им Wine видит всю файловую систему), ярлык .lnk — start. Команда — в ARGS.
ARGS=()
open_args() {
    ARGS=("$1")
    case "${1,,}" in
        *.msi) ARGS=(msiexec /i "$1") ;;
        *.bat|*.cmd) ARGS=(cmd /c "$(win_path "$1")") ;;
        *.reg) ARGS=(regedit "$(win_path "$1")") ;;
        *.lnk) ARGS=(start /unix /wait "$1") ;;
    esac
}

CMD=()
prepare() {
    local runner=$1 file=$2 prefix=$3 how=${4:-} proton="" steam="" id="" args ov dlls=()
    mkdir -p "${prefix}"
    open_args "${file}"
    args=("${ARGS[@]}")
    # Chrome и Steam для Windows: их песочница под Wine не запускается
    [[ ${file,,} == */chrome.exe ]] && args+=(--no-sandbox)
    [[ ${file,,} == */steam.exe ]] && args+=(-no-cef-sandbox)
    ov=$(local_dlls "${file}")
    [ -n "${ov}" ] && dlls=("WINEDLLOVERRIDES=${WINEDLLOVERRIDES:+${WINEDLLOVERRIDES};}${ov}")
    case "${runner}" in
        wine)
            command -v wine >/dev/null || { say "Нет Wine"; exit 1; }
            if [ "${how}" = wait ]; then
                CMD=(env "WINEPREFIX=${prefix}" "${dlls[@]}" sh -c 'wine "$@"; wineserver -w' sh "${args[@]}")
            else
                CMD=(env "WINEPREFIX=${prefix}" "${dlls[@]}" wine "${args[@]}")
            fi
            return 0
            ;;
        proton:*)
            proton=${runner#proton:}
            [ -x "${proton}/proton" ] || { say "Proton не найден" "${proton}"; exit 1; }
            ;;
        *)  # auto: самый свежий, нет ни одного — скачать
            proton=$(latest_proton)
            [ -n "${proton}" ] || proton=$(fetch_proton | tail -n1)
            [ -n "${proton}" ] && [ -x "${proton}/proton" ] || exit 1
            ;;
    esac

    # «reg» и прочие команды внутри префикса — не игра, Steam им не нужен;
    # установщику тоже (а рядом с ним в «Загрузках» может лежать чужая игра)
    if [ "${how}" != wait ] && [[ ${file} == /* ]] && wants_steam "${file}"; then
        if steam=$(steam_dir); then
            fix_steam_root "${steam}"
            start_steam "${steam}"
            id=$(app_id "${file}")
        else
            steam=""
            say "Игре нужен Steam" "Поставьте Steam в «Играх и программах Windows» (плитка Steam) и войдите в аккаунт — без него игра может не запуститься"
        fi
    fi
    PROTON=${proton}
    if [ -z "${steam}" ] && [ "${how}" != wait ] && command -v umu-run >/dev/null; then
        CMD=(env "WINEPREFIX=$(prefix_dir "${prefix}")" "PROTONPATH=${proton}" "GAMEID=${GAMEID:-umu-default}" "${dlls[@]}" umu-run "${args[@]}")
        return 0
    fi
    # Proton напрямую: префикс как у Steam (pfx внутри). Префикс от umu —
    # сам себе pfx: ссылка, чтобы оба способа видели одну и ту же систему.
    [ -d "${prefix}/drive_c" ] && [ ! -e "${prefix}/pfx" ] && ln -s . "${prefix}/pfx"
    # без Steam Proton всё равно ждёт папку клиента — своя, пустая; не
    # ~/.steam/root: туда потом ставит свою ссылку сам Steam
    if [ -z "${steam}" ]; then
        steam=${DATA}/no-steam
        mkdir -p "${steam}"
    fi
    CMD=(env "STEAM_COMPAT_DATA_PATH=${prefix}" "STEAM_COMPAT_CLIENT_INSTALL_PATH=${steam}" "${dlls[@]}")
    # protonfixes в Proton CachyOS без номера игры падает до запуска программы
    # (ищет цифры в пути префикса) — как umu, передаём UMU_ID
    if [ -n "${id}" ]; then CMD+=("SteamAppId=${id}" "SteamGameId=${id}" "STEAM_COMPAT_APP_ID=${id}")
    else CMD+=("UMU_ID=${GAMEID:-umu-default}"); fi
    CMD+=("${proton}/proton" "$([ "${how}" = wait ] && echo waitforexitandrun || echo run)" "${args[@]}")
}

# winebrowser префикса — на delta-open-url: ссылки из программ открывает
# браузер системы с чистым окружением; в контейнере umu его нет, и
# срабатывает xdg-open контейнера (портал OpenURI). Один раз.
browser_links() {
    local runner=$1 prefix=$2 mark=$2/.delta-browser2
    [ -e "${mark}" ] && return 0
    prepare "${runner}" reg "${prefix}"
    # reg — не файл: umu и proton ищут его внутри префикса
    "${CMD[@]}" add 'HKCU\Software\Wine\WineBrowser' /v Browsers /d delta-open-url,xdg-open /f >/dev/null 2>&1 && : >"${mark}"
    CMD=()
}

prefix_of() { printf '%s/%s\n' "${PREFIXES}" "$1"; }
# где сама система Windows: Proton напрямую кладёт её в pfx, umu и Wine — в
# корень (у префикса от umu pfx — ссылка на «.»)
prefix_dir() { if [ -d "$1/pfx" ] && [ ! -L "$1/pfx" ]; then echo "$1/pfx"; else echo "$1"; fi; }
# wineserver того же Proton: ждать, пока в префиксе закончатся все процессы
proton_wineserver() {
    local b
    for b in "$1/files/bin/wineserver" "$1/dist/bin/wineserver"; do
        [ -x "${b}" ] && { echo "${b}"; return 0; }
    done
    return 1
}
# префикс, внутри которого лежит файл: папка с drive_c и system.reg
prefix_root() {
    local d
    d=$(dirname -- "$1")
    while [ -n "${d}" ] && [ "${d}" != / ]; do
        [ -d "${d}/drive_c" ] && [ -f "${d}/system.reg" ] && { echo "${d}"; return 0; }
        d=$(dirname -- "${d}")
    done
    return 1
}
# имя нашего префикса по его папке (prefixes/<имя> или prefixes/<имя>/pfx)
prefix_name() {
    case "$1" in
        "${PREFIXES}"/*) local n=${1#"${PREFIXES}"/}; echo "${n%%/*}" ;;
        *) return 1 ;;
    esac
}
# Префикс программы, поставленной лаунчером вне префикса (на другой диск):
# её ярлык (X-Delta-Exe) или прошлые запуски (.delta-exe) — того же файла или
# соседнего в той же папке
known_prefix() {
    local f=$1 dir d hit
    dir=$(dirname -- "${f}")
    for d in "${APPS}"/delta-exe-*.desktop; do
        [ -f "${d}" ] || continue
        hit=$(sed -n 's/^X-Delta-Exe=//p' "${d}" | head -n1)
        [ "${hit}" = "${f}" ] || [ "$(dirname -- "${hit}")" = "${dir}" ] || continue
        sed -n 's/^X-Delta-Prefix=//p' "${d}" | head -n1
        return 0
    done
    for d in "${PREFIXES}"/*/.delta-exe; do
        [ -f "${d}" ] || continue
        while IFS= read -r hit; do
            [ "$(dirname -- "${hit}")" = "${dir}" ] && { basename -- "$(dirname -- "${d}")"; return 0; }
        done <"${d}"
    done
    return 1
}
# раннер, которым ставили программу в префикс (иначе — тот, что выбрали)
prefix_runner() {
    local f
    f=$(prefix_of "$1")/.delta-runner
    if [ -s "${f}" ]; then head -n1 "${f}"; else echo "$2"; fi
}
# программа из чужого префикса Wine (обычно ~/.wine): там же, Wine системы
run_in_wine_prefix() {
    command -v wine >/dev/null || { say "Нет Wine" "Программа поставлена через Wine — поставьте его: «Настройки» → «Рекомендации» → «Библиотеки»"; exit 1; }
    remember "$2" "${DATA}/normal"
    cd -- "$(dirname -- "$2")" || true
    open_args "$2"
    exec env "WINEPREFIX=$1" wine "${ARGS[@]}"
}
# имя префикса и ярлыка: латиница, цифры, . _ - (кириллица и пробелы — в «-»)
slug() { printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -cs 'a-z0-9._-' '-' | sed 's/^-*//; s/-*$//' | cut -c1-48; }

# --- библиотеки для игр ---
# Как Steam ставит игре её _CommonRedist: delta-pe смотрит exe и DLL игры
# (таблицы импорта, DLL, которые она грузит по имени, папки с
# распространяемыми пакетами) и называет пакеты winetricks — рантаймы
# Visual C++, d3dx9, XAudio, PhysX, OpenAL, XNA… То, что игра принесла с
# собой, не ставится. Пакеты ставятся в префикс один раз (.delta-deps),
# скачанное остаётся в кэше winetricks (~/.cache/winetricks) для других
# игр. Пакет не встал — помечается «!пакет» и больше не пробуется: игра
# всё равно запускается. DLL, которых нет ни у игры, ни у Wine, — в журнал.
# Выключается в «Настройки» → «Рекомендации» (exe.deps).
WT_VERSION=20260125
WT_SHA256=431f82fc74000e6c864409f1d8fb495d696c03928808e3e8acffc45179312a7b
# winetricks: системный, из Proton (protonfixes) или официальный скрипт
# закреплённой версии со сверкой sha256 (пакет winetricks тянет за собой Wine)
winetricks_bin() {
    local w
    command -v winetricks && return 0
    for w in "${1:-}/protonfixes/winetricks" "${1:-}/files/protonfixes/winetricks"; do
        [ -n "${1:-}" ] && [ -x "${w}" ] && { echo "${w}"; return 0; }
    done
    w=${DATA}/winetricks-${WT_VERSION}
    if [ ! -x "${w}" ]; then
        mkdir -p "${DATA}"
        curl -fsSL --max-time 120 -o "${w}.part" \
            "https://raw.githubusercontent.com/Winetricks/winetricks/${WT_VERSION}/src/winetricks" 2>/dev/null &&
            [ "$(sha256sum <"${w}.part" | cut -d' ' -f1)" = "${WT_SHA256}" ] &&
            chmod +x "${w}.part" && mv -f -- "${w}.part" "${w}"
        rm -f -- "${w}.part"
    fi
    [ -x "${w}" ] && echo "${w}"
}
proton_wine() {
    local b
    for b in "$1/files/bin/wine" "$1/dist/bin/wine"; do
        [ -x "${b}" ] && { echo "${b}"; return 0; }
    done
    return 1
}
# встроенные DLL Wine — чтобы отличить «нет нигде» от «есть у Wine»
wine_dll_dirs() {
    local base d
    if [ -n "${1:-}" ]; then base=("$1/files/lib/wine" "$1/files/lib64/wine" "$1/dist/lib/wine" "$1/dist/lib64/wine")
    else base=(/usr/lib/wine /usr/lib32/wine); fi
    for d in "${base[@]}"; do
        [ -d "${d}" ] || continue
        printf '%s\n' "${d}/x86_64-windows" "${d}/i386-windows"
    done
}
# $1 раннер, $2 файл, $3 префикс
game_deps() {
    local runner=$1 file=$2 prefix=$3 proton="" info verbs=() v todo=() done_f=$3/.delta-deps wt wine ws have=() d code
    [ "$(setting '.exe.deps' true)" = false ] && return 0
    [[ ${file} == /* ]] && [[ ${file,,} == *.exe ]] || return 0
    command -v delta-pe >/dev/null || return 0
    case "${runner}" in
        wine) ;;
        proton:*) proton=${runner#proton:} ;;
        *) proton=$(latest_proton) ;;
    esac
    while IFS= read -r d; do have+=(--have "${d}"); done < <(wine_dll_dirs "${proton}")
    info=$(delta-pe deps "${file}" --root "$(game_root "${file}")" "${have[@]}" 2>/dev/null) || return 0
    mapfile -t verbs < <(jq -r '.verbs[]' <<<"${info}")
    for v in "${verbs[@]}"; do
        grep -qxF -e "${v}" -e "!${v}" "${done_f}" 2>/dev/null || todo+=("${v}")
    done
    mkdir -p "${STATE}"
    if [ "$(jq '.missing | length' <<<"${info}")" -gt 0 ]; then
        printf '=== %s  нет ни у игры, ни у Wine: %s\n' "$(date '+%F %T')" "$(jq -r '.missing | join(" ")' <<<"${info}")" >>"${LOG}"
    fi
    [ "${#todo[@]}" -gt 0 ] || return 0
    printf '\n=== %s  библиотеки для %s: %s (%s)\n' "$(date '+%F %T')" "$(basename -- "${file}")" "${todo[*]}" \
        "$(jq -r '[.why | to_entries[] | "\(.key): \(.value | join(", "))"] | join("; ")' <<<"${info}")" >>"${LOG}"
    if [ "${DELTA_DRY_RUN:-0}" = 1 ]; then
        printf '=== (проверка) winetricks -q %s\n' "${todo[*]}" >>"${LOG}"
        return 0
    fi
    command -v cabextract >/dev/null || { say "Нужен cabextract" "Без него библиотеки для игры не поставить: sudo pacman -S cabextract"; return 0; }
    wt=$(winetricks_bin "${proton}") || { say "Библиотеки не поставлены" "Не удалось получить winetricks — игра запустится без них"; return 0; }
    if [ -n "${proton}" ]; then
        wine=$(proton_wine "${proton}") && ws=$(proton_wineserver "${proton}") || return 0
    else
        wine=$(command -v wine) && ws=$(command -v wineserver) || return 0
    fi
    say "Первый запуск: ставлю библиотеки" "$(basename -- "$(game_root "${file}")"): ${todo[*]} — это один раз, займёт несколько минут"
    for v in "${todo[@]}"; do
        env WINEPREFIX="$(prefix_dir "${prefix}")" WINE="${wine}" WINESERVER="${ws}" WINEDEBUG=-all \
            WINETRICKS_LATEST_VERSION_CHECK=disabled "${wt}" -q --unattended "${v}" >>"${LOG}" 2>&1
        code=$?
        if [ "${code}" = 0 ]; then printf '%s\n' "${v}" >>"${done_f}"; else printf '!%s\n' "${v}" >>"${done_f}"; fi
        printf '=== winetricks %s: код %s\n' "${v}" "${code}" >>"${LOG}"
    done
    WINEPREFIX=$(prefix_dir "${prefix}") "${ws}" -w >/dev/null 2>&1
    trim_log
}

run_launcher() {
    local runner=$1 file=$2 name=${3:-} prefix root id
    # игра, поставленная самим Steam, — через Steam: его Proton и настройки
    # игры, вход в аккаунт, облачные сохранения
    if [[ ${file} == /* ]] && id=$(library_id "${file}") && [ -n "${id}" ] && command -v steam >/dev/null; then
        mkdir -p "${STATE}"
        printf '\n=== %s  через Steam: steam://rungameid/%s (%s)\n' "$(date '+%F %T')" "${id}" "${file}" >>"${LOG}"
        pgrep -x steam >/dev/null || say "Steam" "Игра из библиотеки Steam — запускаю её через Steam"
        setsid -f steam "steam://rungameid/${id}" >/dev/null 2>&1 </dev/null
        exit 0
    fi
    # exe из уже существующего префикса — в нём же и тем же раннером
    if [ -z "${name}" ] && root=$(prefix_root "${file}"); then
        name=$(prefix_name "${root}") || run_in_wine_prefix "${root}" "${file}"
        runner=$(prefix_runner "${name}" "${runner}")
    elif [ -z "${name}" ] && name=$(known_prefix "${file}") && [ -d "$(prefix_of "${name}")" ]; then
        runner=$(prefix_runner "${name}" "${runner}")
    else
        name=${name:-}
    fi
    if [ -z "${name}" ]; then name=$(key_of "${file}"); name=${name%.*}; fi
    prefix=$(prefix_of "${name}")
    mkdir -p "${prefix}"
    remember "${file}" "${prefix}/.delta-exe"
    cd -- "$(dirname -- "${file}")" || true
    [ "${runner}" = wine ] || browser_links "${runner}" "${prefix}"
    game_deps "${runner}" "${file}" "${prefix}"
    prepare "${runner}" "${file}" "${prefix}"
    run_logged "${prefix}"
    exit
}

# Запуск — в журнал: команда, код и время. Закрылась за минуту — туда же
# конец вывода (весь — в exe-last.log) и объяснение в уведомлении: игре на
# Unity, которая не подключилась к Steam (сама пишет об этом в Player.log и
# выходит), — что нужен Steam со входом в аккаунт; остальным — где журнал.
run_logged() {
    local prefix=$1 t0 code secs out=${STATE}/exe-last.log plog
    mkdir -p "${STATE}"
    t0=$(date +%s)
    printf '\n=== %s  запуск: %s\n' "$(date '+%F %T')" "${CMD[*]}" >>"${LOG}"
    "${CMD[@]}" >"${out}" 2>&1
    code=$?
    secs=$(( $(date +%s) - t0 ))
    printf '=== код %s, %s с\n' "${code}" "${secs}" >>"${LOG}"
    if [ "${secs}" -lt 60 ]; then
        tail -n 40 "${out}" >>"${LOG}"
        plog=$(find "$(drive_c "${prefix}")/users" -maxdepth 6 -name Player.log -newermt "@${t0}" 2>/dev/null | head -n1)
        if [ -n "${plog}" ] && grep -qiE 'Steam not initialized|SteamApi_Init failed|SteamAPI_Init\(\) failed' "${plog}"; then
            printf '=== Player.log: игра не подключилась к Steam\n' >>"${LOG}"
            say "Игра не подключилась к Steam" "Steam её не пустил: игры нет в вашей библиотеке Steam или неизвестен её номер (steam_appid.txt). Купленную игру поставьте через Steam — она запустится из «Игр и программ Windows»"
        elif [ "${code}" -ne 0 ]; then
            say "Программа закрылась через ${secs} с" "Код ${code}. Подробности — в ~/.local/state/delta/exe.log"
        fi
    fi
    trim_log
    return "${code}"
}

# --- установка программы ---
# drive_c префикса: у Proton напрямую — внутри pfx, у umu и Wine — сам префикс
drive_c() { if [ -d "$1/pfx/drive_c" ]; then echo "$1/pfx/drive_c"; else echo "$1/drive_c"; fi; }
# ярлыки .lnk в меню «Пуск» и на рабочих столах префикса
list_links() {
    local c
    c=$(drive_c "$1")
    [ -d "${c}" ] || return 0
    find "${c}/users" "${c}/ProgramData" -iname '*.lnk' 2>/dev/null | sort
}
# куда ведёт ярлык: путь C:\…\x.exe внутри .lnk (ASCII или UTF-16 — нули убираем)
link_target() {
    local t c
    # перед путём бывает печатный байт заголовка — ищем путь в любом месте строки
    t=$(tr -d '\000' <"$1" | tr -c '[:print:]' '\n' | grep -aoiE '[a-z]:\\[^:*?"<>|]+\.exe' | head -n1)
    [ -n "${t}" ] || return 1
    case ${t:0:1} in
        [Cc]) c=$(drive_c "$2") ;;
        [Zz]) c="" ;;            # Z: — корень Linux
        *) return 1 ;;
    esac
    t=${t:3}
    printf '%s/%s\n' "${c}" "${t//\\//}"
}
# значок из .exe (icoutils): самый большой PNG; нет — значок Wine.
# Печатает только путь: её вывод идёт в строку Icon= ярлыка. Раньше -o стоял
# после «--» и считался файлом — wrestool писал сам значок в вывод, в Icon=
# попадали сотни КБ двоичных данных, и оболочка падала, читая такой ярлык.
exe_icon() {
    local exe=$1 id=$2 out tmp best
    command -v wrestool >/dev/null && command -v icotool >/dev/null || { echo wine; return; }
    mkdir -p "${ICONS}"
    out=${ICONS}/${id}.png
    tmp=$(mktemp -d) || { echo wine; return; }
    wrestool -x -t 14 -o "${tmp}" -- "${exe}" >/dev/null 2>&1
    for f in "${tmp}"/*.ico; do [ -f "${f}" ] && icotool -x -o "${tmp}" -- "${f}" >/dev/null 2>&1; done
    best=$(ls -S "${tmp}"/*.png 2>/dev/null | head -n1)
    if [ -n "${best}" ]; then mv -f -- "${best}" "${out}"; echo "${out}"; else echo wine; fi
    rm -rf "${tmp}"
}
# строка Exec= по правилам .desktop: путь в кавычках, \ " ` $ — экранированы
desktop_quote() { local v=$1; v=${v//\\/\\\\}; v=${v//\"/\\\"}; v=${v//\`/\\\`}; v=${v//\$/\\\$}; printf '"%s"' "${v}"; }

add_app() {  # префикс, имя префикса, ярлык или пусто, exe[, название]
    local prefix=$1 pname=$2 lnk=$3 exe=$4 title=${5:-} id file icon
    [ -n "${title}" ] || title=$([ -n "${lnk}" ] && basename -- "${lnk}" .lnk || basename -- "${exe}" .exe)
    # в строке .desktop — ни переводов строки, ни управляющих символов
    title=$(printf '%s' "${title}" | tr -d '\000-\037\177' | cut -c1-120)
    [ -n "${title}" ] || title=$(basename -- "${exe}" .exe)
    # название без латиницы (кириллица) — slug пуст: имя ярлыка по пути exe
    id=$(slug "${title}")
    [ -n "${id}" ] || id=$(printf '%s' "${exe}" | md5sum | cut -c1-10)
    id=delta-exe-${pname}-${id}
    file=${APPS}/${id}.desktop
    mkdir -p "${APPS}"
    # значок — одной строкой-путём; что-то другое (ошибка инструмента) — значок Wine
    icon=$(exe_icon "${exe}" "${id}" | head -n1)
    case "${icon}" in wine|/*.png) ;; *) icon=wine ;; esac
    {
        echo '[Desktop Entry]'
        echo 'Type=Application'
        echo "Name=${title}"
        echo "Comment=Программа Windows (${pname})"
        echo "Exec=delta-exe --app ${pname} $(desktop_quote "${exe}")"
        echo "Path=$(dirname -- "${exe}")"
        echo "Icon=${icon}"
        echo 'Categories=Wine;'
        echo 'StartupNotify=true'
        echo "X-Delta-Prefix=${pname}"
        echo "X-Delta-Exe=${exe}"
    } >"${file}"
    printf '%s\n' "${title}"
}

install_app() {
    local runner=$1 file=$2 pname prefix before after lnk exe added=() n ws code
    pname=$(slug "$3")
    [ -n "${pname}" ] || pname=$(slug "$(basename -- "${file%.*}")")
    [ -n "${pname}" ] || pname=app
    prefix=$(prefix_of "${pname}")
    mkdir -p "${prefix}"
    printf '%s\n' "${runner}" >"${prefix}/.delta-runner"
    before=$(list_links "${prefix}")
    cd -- "$(dirname -- "${file}")" || true
    [ "${runner}" = wine ] || browser_links "${runner}" "${prefix}"
    say "Установка" "Идёт установка «$3» — следуйте шагам установщика"
    prepare "${runner}" "${file}" "${prefix}" wait
    # вывод — в журнал: если установщик сразу закрылся, там видно почему
    mkdir -p "${STATE}"
    printf '\n=== %s  %s\n' "$(date '+%F %T')" "${CMD[*]}" >>"${LOG}"
    "${CMD[@]}" >>"${LOG}" 2>&1
    code=$?
    # установщик мог передать работу дочернему процессу и выйти — ждём все
    if [ "${runner}" != wine ] && ws=$(proton_wineserver "${PROTON}"); then
        WINEPREFIX=$(prefix_dir "${prefix}") "${ws}" -w >>"${LOG}" 2>&1
    fi
    printf '=== код %s\n' "${code}" >>"${LOG}"
    trim_log
    after=$(list_links "${prefix}")

    # новые ярлыки (или все, если префикс уже был с ними), кроме удаления и справки
    while IFS= read -r lnk; do
        [ -n "${lnk}" ] || continue
        case "$(basename -- "${lnk}" | tr '[:upper:]' '[:lower:]')" in
            *uninstall*|*unins*|*удал*|*readme*|*help*|*справк*|*manual*|*website*|*web\ site*|*.url) continue ;;
        esac
        exe=$(link_target "${lnk}" "${prefix}") || continue
        [ -f "${exe}" ] || continue
        added+=("$(add_app "${prefix}" "${pname}" "${lnk}" "${exe}")")
    done < <(comm -13 <(printf '%s\n' "${before}") <(printf '%s\n' "${after}") | sort -u)

    # ярлыков нет — самые большие новые .exe в Program Files (кроме служебных)
    if [ "${#added[@]}" = 0 ]; then
        while IFS= read -r exe; do
            added+=("$(add_app "${prefix}" "${pname}" "" "${exe}")")
        done < <(find "$(drive_c "${prefix}")"/Program\ Files* -iname '*.exe' -size +200k 2>/dev/null \
                 | grep -viE '/(unins|setup|install|update|crash|report|vc_?redist|dxsetup|dotnet|directx)[^/]*\.exe$' \
                 | xargs -r -d '\n' ls -S 2>/dev/null | head -n 2)
    fi
    n=${#added[@]}
    command -v update-desktop-database >/dev/null && update-desktop-database "${APPS}" 2>/dev/null
    if [ "${n}" -gt 0 ]; then
        say "Программа установлена" "$(printf '%s, ' "${added[@]}" | sed 's/, $//') — в меню приложений"
    elif [ "${code}" != 0 ] && [ -z "${after}" ]; then
        say "Установка не удалась" "Установщик закрылся с ошибкой (код ${code}). Подробности: ${LOG}"
    else
        say "Установка закончилась" "Ярлыков программа не оставила — её можно запустить из «Программ Windows»"
    fi
}

# запуск установленной: раннер — тот, которым ставили
run_app() {
    local pname=$1 file=$2 runner=auto
    [ -f "$(prefix_of "${pname}")/.delta-runner" ] && runner=$(head -n1 "$(prefix_of "${pname}")/.delta-runner")
    if [ ! -f "${file}" ]; then
        # программу удалили — её ярлык из меню убираем сам (диск не подключён — нет)
        if reachable "${file}"; then
            tidy
            say "Программа не найдена" "Её больше нет — ярлык убран из меню приложений"
        else
            say "Программа не найдена" "Диск с ней не подключён: ${file}"
        fi
        exit 1
    fi
    run_launcher "${runner}" "${file}" "${pname}"
}

# --- «Программы Windows» ---
# программы префикса $1 (имя): ярлыки из меню и всё, что в нём запускали
apps_json() {
    local name=$1 prefix d exe
    prefix=$(prefix_of "${name}")
    {
        for d in "${APPS}"/delta-exe-*.desktop; do
            [ -f "${d}" ] && grep -qx "X-Delta-Prefix=${name}" "${d}" || continue
            exe=$(sed -n 's/^X-Delta-Exe=//p' "${d}" | head -n1)
            jq -n --arg title "$(sed -n 's/^Name=//p' "${d}" | head -n1)" --arg exe "${exe}" \
                --arg icon "$(sed -n 's/^Icon=//p' "${d}" | head -n1)" --arg desktop "${d}" \
                '{ title: $title, exe: $exe, icon: $icon, desktop: $desktop }'
        done
        [ -f "${prefix}/.delta-exe" ] && while IFS= read -r exe; do
            [ -f "${exe}" ] || continue
            jq -n --arg title "$(basename -- "${exe%.*}")" --arg exe "${exe}" \
                '{ title: $title, exe: $exe, icon: "", desktop: "" }'
        done <"${prefix}/.delta-exe"
    } | jq -s 'unique_by(.exe | ascii_downcase) | sort_by(.desktop == "", (.title | ascii_downcase))'
}
list_json() {
    local d name prefixes="" normal
    for d in "${PREFIXES}"/*/; do
        [ -d "${d}" ] || continue
        name=$(basename -- "${d}")
        prefixes+=$(jq -n --arg name "${name}" --arg path "${d%/}" \
            --arg runner "$(prefix_runner "${name}" auto)" \
            --arg size "$(du -sh -- "${d}" 2>/dev/null | cut -f1)" \
            --argjson ready "$([ -d "$(prefix_dir "${d%/}")/drive_c" ] && echo true || echo false)" \
            --argjson apps "$(apps_json "${name}")" \
            '{ name: $name, path: $path, runner: $runner, size: $size, ready: $ready, apps: $apps }')
    done
    normal=$(while IFS= read -r f; do [ -f "${f}" ] && jq -n --arg title "$(basename -- "${f%.*}")" --arg exe "${f}" '{ title: $title, exe: $exe, icon: "", desktop: "" }'; done \
        <"${DATA}/normal" 2>/dev/null | jq -s .)
    jq -n --argjson prefixes "$(printf '%s' "${prefixes}" | jq -s .)" --argjson normal "${normal:-[]}" \
        --argjson runners "$(runners_json)" --arg home "${PREFIXES}" \
        '{ prefixes: $prefixes, normal: $normal, runners: $runners, home: $home }'
}
# только наши префиксы: имя без «/» и «..»
check_prefix() {
    case "$1" in ""|.|..|*/*) echo "delta-exe: неверное имя префикса" >&2; exit 2 ;; esac
    [ -d "$(prefix_of "$1")" ] || { say "Префикс не найден" "$1"; exit 1; }
}
winecfg() {
    local runner
    runner=$(prefix_runner "$1" auto)
    [ "${runner}" = wine ] || browser_links "${runner}" "$(prefix_of "$1")"
    prepare "${runner}" winecfg "$(prefix_of "$1")"
    exec "${CMD[@]}"
}
remove_prefix() {
    local d
    for d in "${APPS}"/delta-exe-*.desktop; do
        [ -f "${d}" ] && grep -qx "X-Delta-Prefix=$1" "${d}" && rm -f -- "${d}"
    done
    rm -rf -- "$(prefix_of "$1")"
    command -v update-desktop-database >/dev/null && update-desktop-database "${APPS}" 2>/dev/null
    return 0
}

# --- удаление программы и уборка ярлыков ---
desk_value() { sed -n "s/^$2=//p" "$1" | head -n1; }

# Папка программы внутри C: — её и удаляем: Program Files[ (x86)]\<папка>,
# ProgramData\<папка>, users\<кто>\AppData\{Local,Roaming}\<папка> или папка
# прямо в C:. Общие (Common Files, Windows, сама users) — никогда.
program_dir() {
    local exe=$1 c=$2 rel top rest sub
    local -a parts
    case "${exe}" in "${c}"/*) ;; *) return 1 ;; esac
    rel=${exe#"${c}"/}
    top=${rel%%/*}
    [ "${top}" != "${rel}" ] || return 1
    rest=${rel#*/}
    case "${top,,}" in
        windows) return 1 ;;
        users)
            # users/<кто>/AppData/Local|Roaming/<папка>/…
            IFS=/ read -r -a parts <<<"${rest}"
            [ "${#parts[@]}" -ge 5 ] && [ "${parts[1],,}" = appdata ] || return 1
            case "${parts[2],,}" in local|roaming) ;; *) return 1 ;; esac
            [ "${parts[3],,}" = microsoft ] && return 1
            printf '%s/users/%s/%s/%s/%s\n' "${c}" "${parts[0]}" "${parts[1]}" "${parts[2]}" "${parts[3]}"
            ;;
        "program files"|"program files (x86)"|programdata)
            sub=${rest%%/*}
            [ "${sub}" != "${rest}" ] || return 1
            case "${sub,,}" in "common files"|microsoft|"windows nt"|"internet explorer"|"windows media player") return 1 ;; esac
            printf '%s/%s/%s\n' "${c}" "${top}" "${sub}"
            ;;
        *) printf '%s/%s\n' "${c}" "${top}" ;;
    esac
}

# План удаления по ярлыку .desktop (JSON для окна подтверждения):
#   dir — папка программы, которую удалим; keep — файлы вне Box, которые
#   остаются (игра, запущенная из своей папки); prefix — у программы своя
#   система Windows, и после неё там ничего не останется — удалим целиком.
uninstall_plan() {
    local desk=$1 exe pname prefix c dir="" keep="" whole=false d x left=0
    exe=$(desk_value "${desk}" X-Delta-Exe)
    pname=$(desk_value "${desk}" X-Delta-Prefix)
    case "${pname}" in ""|.|..|*/*) return 1 ;; esac
    prefix=$(prefix_of "${pname}")
    c=$(drive_c "${prefix}")
    dir=$(program_dir "${exe}" "${c}") || dir=""
    case "${exe}" in "${prefix}"/*) ;; *) keep=$(dirname -- "${exe}") ;; esac
    # другие ярлыки того же префикса, не из этой папки
    for d in "${APPS}"/delta-exe-*.desktop; do
        [ -f "${d}" ] && [ "${d}" != "${desk}" ] && grep -qx "X-Delta-Prefix=${pname}" "${d}" || continue
        x=$(desk_value "${d}" X-Delta-Exe)
        [ -n "${dir}" ] && case "${x}" in "${dir}"/*) continue ;; esac
        left=$((left + 1))
    done
    # Delta Box — общая система: её не удаляем никогда
    [ "${pname}" != delta-box ] && [ "${left}" = 0 ] && [ -d "${prefix}" ] && whole=true
    jq -n --arg name "$(desk_value "${desk}" Name)" --arg exe "${exe}" --arg prefixName "${pname}" \
        --arg dir "${dir}" --arg keep "${keep}" --argjson whole "${whole}" \
        --arg size "$(if [ "${whole}" = true ]; then du -sh -- "${prefix}" 2>/dev/null | cut -f1; elif [ -n "${dir}" ]; then du -sh -- "${dir}" 2>/dev/null | cut -f1; fi)" \
        '{ kind: "windows", name: $name, exe: $exe, prefix: $prefixName, dir: $dir, keep: $keep, whole: $whole, size: $size }'
}

uninstall_app() {
    local desk=$1 plan exe pname prefix dir whole d x lnk t
    plan=$(uninstall_plan "${desk}") || { echo "delta-exe: это не ярлык программы Windows" >&2; exit 2; }
    exe=$(jq -r .exe <<<"${plan}"); pname=$(jq -r .prefix <<<"${plan}")
    dir=$(jq -r .dir <<<"${plan}"); whole=$(jq -r .whole <<<"${plan}")
    prefix=$(prefix_of "${pname}")
    if [ "${whole}" = true ]; then
        remove_prefix "${pname}"
        rm -f -- "${desk}" "${ICONS}/$(basename -- "${desk}" .desktop).png"
        return 0
    fi
    # ярлыки этой программы: этот и все, что ведут в её папку
    for d in "${APPS}"/delta-exe-*.desktop; do
        [ -f "${d}" ] && grep -qx "X-Delta-Prefix=${pname}" "${d}" || continue
        x=$(desk_value "${d}" X-Delta-Exe)
        if [ "${d}" = "${desk}" ] || { [ -n "${dir}" ] && case "${x}" in "${dir}"/*) true ;; *) false ;; esac; }; then
            rm -f -- "${d}" "${ICONS}/$(basename -- "${d}" .desktop).png"
        fi
    done
    if [ -n "${dir}" ]; then
        # её ярлыки в «Пуске» и на рабочем столе Windows
        while IFS= read -r lnk; do
            t=$(link_target "${lnk}" "${prefix}") || continue
            case "${t}" in "${dir}"/*) rm -f -- "${lnk}" ;; esac
        done < <(list_links "${prefix}")
        rm -rf -- "${dir}"
    fi
    command -v update-desktop-database >/dev/null && update-desktop-database "${APPS}" 2>/dev/null
    return 0
}

# файл на диске, который сейчас не подключён (флешка, второй диск), — не
# «пропал»: его ярлык не трогаем
reachable() {
    local root
    case "$1" in
        /run/media/*/*/*) root=$(cut -d/ -f1-5 <<<"$1") ;;
        /media/*/*|/mnt/*/*) root=$(cut -d/ -f1-3 <<<"$1") ;;
        *) return 0 ;;
    esac
    mountpoint -q -- "${root}"
}

# Уборка ярлыков программ Windows: программы нет (удалили её папку, сам
# префикс) — ярлык долой; ярлык прежних версий с двоичным мусором в Icon=
# (оболочка на нём падала) — пересоздать.
tidy() {
    local d exe pname title
    for d in "${APPS}"/delta-exe-*.desktop; do
        [ -f "${d}" ] || continue
        exe=$(desk_value "${d}" X-Delta-Exe)
        pname=$(desk_value "${d}" X-Delta-Prefix)
        [ -n "${exe}" ] || continue
        if [ ! -e "${exe}" ]; then
            reachable "${exe}" || continue
            rm -f -- "${d}" "${ICONS}/$(basename -- "${d}" .desktop).png"
            continue
        fi
        if [ "$(stat -c %s -- "${d}")" -gt 8192 ]; then
            title=$(desk_value "${d}" Name)
            rm -f -- "${d}"
            [ -n "${pname}" ] && [ -d "$(prefix_of "${pname}")" ] && add_app "$(prefix_of "${pname}")" "${pname}" "" "${exe}" "${title}" >/dev/null
        fi
    done
    command -v update-desktop-database >/dev/null && update-desktop-database "${APPS}" 2>/dev/null
    return 0
}

case "${1:-}" in
    -h|--help)
        sed -n '2,/^set -u/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    --runners) runners_json; exit 0 ;;
    # путь к самому свежему Proton CachyOS (нет — скачать): им запускает игры Epic delta-games
    --proton)  p=$(latest_proton); [ -n "${p}" ] || p=$(fetch_proton | tail -n1); [ -n "${p}" ] || exit 1; printf '%s\n' "${p}"; exit 0 ;;
    --fetch)   fetch_proton; exit $? ;;
    --install) [ -n "${3:-}" ] || exit 2; install_app "$2" "$3" "${4:-}"; exit 0 ;;
    --app)     [ -n "${3:-}" ] || exit 2; run_app "$2" "$3" ;;
    --add-app)
        check_prefix "${2:-}"; [ -f "${3:-}" ] || exit 2
        add_app "$(prefix_of "$2")" "$2" "" "$3" "${4:-}" >/dev/null
        command -v update-desktop-database >/dev/null && update-desktop-database "${APPS}" 2>/dev/null
        exit 0
        ;;
    --manager) exec qs -p "${MANAGER}" -d ;;
    --list)    list_json; exit 0 ;;
    --set-runner) check_prefix "${2:-}"; [ -n "${3:-}" ] || exit 2; printf '%s\n' "$3" >"$(prefix_of "$2")/.delta-runner"; exit 0 ;;
    --winecfg) check_prefix "${2:-}"; winecfg "$2" ;;
    --folder)  check_prefix "${2:-}"; exec xdg-open "$(drive_c "$(prefix_of "$2")")" ;;
    --remove)  check_prefix "${2:-}"; remove_prefix "$2"; exit 0 ;;
    --uninstall-info) [ -f "${2:-}" ] || exit 2; uninstall_plan "$2"; exit $? ;;
    --uninstall) [ -f "${2:-}" ] || exit 2; uninstall_app "$2"; exit 0 ;;
    --tidy)    tidy; exit 0 ;;
    --deps)
        [ -f "${2:-}" ] || exit 2
        f=$(realpath -- "$2")
        n=$(known_prefix "${f}") || { n=$(key_of "${f}"); n=${n%.*}; }
        delta-pe deps "${f}" --root "$(game_root "${f}")" |
            jq --arg p "$(prefix_of "${n}")" --rawfile d <(cat "$(prefix_of "${n}")/.delta-deps" 2>/dev/null) \
                '. + { prefix: $p, installed: ($d | split("\n") | map(select(length > 0))) }'
        exit 0 ;;
    --run)
        mode=${2:-}
        if [ "${mode}" = normal ]; then
            [ -n "${3:-}" ] || exit 2
            run_normal "$3"
        fi
        [ "${mode}" = launcher ] && [ -n "${4:-}" ] || exit 2
        run_launcher "$3" "$4"
        ;;
    ""|-*) echo "delta-exe: нужен файл .exe" >&2; exit 2 ;;
esac

file=$(realpath -- "$1" 2>/dev/null || printf '%s' "$1")
[ -f "${file}" ] || { say "Файл не найден" "${file}"; exit 1; }
key=$(key_of "${file}")

# окно выбора выключено или программа в списке «обычно»
if [ "$(setting '.exe.enabled' true)" = false ] ||
   { [ -f "${CONFIG}" ] && jq -e --arg k "${key}" '(.exe.excluded // []) | map(ascii_downcase) | index($k)' "${CONFIG}" >/dev/null 2>&1; }; then
    run_normal "${file}"
fi
# «Всегда так» через лаунчер
remembered=""
[ -f "${CONFIG}" ] && remembered=$(jq -r --arg k "${key}" '.exe.always[$k] // empty' "${CONFIG}" 2>/dev/null)
[ -n "${remembered}" ] && run_launcher "${remembered}" "${file}"

export DELTA_EXE_FILE=${file}
exec qs -p "${ENTRY}" -d
