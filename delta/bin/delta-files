#!/usr/bin/env bash
# Файлы Delta — проводник с архиватором.
#
#   delta-files [папка|файл]              окно (архив открывается как папка)
#   delta-files --list <архив>            содержимое архива: «тип<TAB>размер<TAB>путь»
#   delta-files --extract <архив> <куда> [--smart] [--entry <путь>]…
#                                         распаковать; --smart — архив с одной
#                                         папкой (файлом) внутри кладётся прямо
#                                         в <куда>, иначе в папку с именем архива.
#                                         Пароль — в переменной DELTA_FILES_PASSWORD.
#                                         Пишет «::progress:: <0…100>», в конце
#                                         «::done:: <путь>»; нужен пароль — код 3
#   delta-files --compress <zip|7z|tar.zst|tar.gz|tar.xz> <архив> <папка> <имя>…
#                                         сжать файлы <имя>… из <папка>
#   delta-files --is-archive <файл>       код 0 — это архив, который мы откроем
#   delta-files --paste copy|move <куда> <файл>…
#                                         вставить; занятое имя — «имя (2)»
#   delta-files ipc …                     команда окну
#
# Архивы читает libarchive (bsdtar): zip, 7z, rar (и rar5), tar с gz/bz2/xz/zst/
# lz4, iso, cab, cpio, deb, rpm, xar, lha. Есть 7z (пакет 7zip) — им открываются
# и зашифрованные 7z и rar5; unrar — старые rar с паролем. Одиночные .gz/.xz/.zst/
# .bz2/.lz4 без tar — их же программами.
set -u

DELTA_DATA=${DELTA_DATA:-/usr/share/delta}
SHELL_DIR=${DELTA_SHELL_DIR:-${DELTA_DATA}/shell}
ENTRY=${DELTA_FILES_ENTRY:-${SHELL_DIR}/files-app.qml}
PASS=${DELTA_FILES_PASSWORD:-}

# одиночный сжатый файл (не tar): расширение → чем распаковать
single() {
    case "${1,,}" in
        *.tar.*|*.tgz|*.tbz|*.tbz2|*.txz|*.tzst) return 1 ;;
        *.gz)  echo "gzip -dc" ;;
        *.bz2) echo "bzip2 -dc" ;;
        *.xz)  echo "xz -dc" ;;
        *.lzma) echo "xz --format=lzma -dc" ;;
        *.zst) echo "zstd -dcq" ;;
        *.lz4) echo "lz4 -dc" ;;
        *) return 1 ;;
    esac
}
strip_ext() {
    local b
    b=$(basename -- "$1")
    case "${b,,}" in
        *.tar.gz|*.tar.xz|*.tar.bz2|*.tar.zst|*.tar.lz4|*.tar.lzma) b=${b%.*}; b=${b%.*} ;;
        *.*) b=${b%.*} ;;
    esac
    [ -n "${b}" ] || b=archive
    printf '%s\n' "${b}"
}
is_archive() {
    single "$1" >/dev/null && return 0
    case "${1,,}" in
        *.zip|*.7z|*.rar|*.tar|*.tar.*|*.tgz|*.tbz|*.tbz2|*.txz|*.tzst|*.iso|*.cab|*.cpio|*.deb|*.rpm|*.xar|*.pkg|*.lha|*.lzh|*.jar|*.apk|*.ar|*.zipx|*.cbz|*.cbr|*.cb7|*.xpi|*.whl|*.epub)
            return 0 ;;
    esac
    return 1
}
has() { command -v "$1" >/dev/null 2>&1; }
# свободное имя: «имя», «имя (2)», …
free_name() {
    local p=$1 n=2 base ext
    [ -e "${p}" ] || { printf '%s\n' "${p}"; return; }
    base=${p%.*}; ext=${p##*.}
    if [ "${base}" = "${p}" ] || [ -d "${p}" ] || case "${p##*/}" in .*) true ;; *) false ;; esac; then
        while [ -e "${p} (${n})" ]; do n=$((n + 1)); done
        printf '%s\n' "${p} (${n})"
    else
        while [ -e "${base} (${n}).${ext}" ]; do n=$((n + 1)); done
        printf '%s\n' "${base} (${n}).${ext}"
    fi
}

# --- содержимое: «d|f<TAB>размер<TAB>путь» ---
list_archive() {
    local a=$1 out
    if cmd=$(single "${a}"); then
        printf 'f\t0\t%s\n' "$(strip_ext "${a}")"
        return 0
    fi
    # bsdtar -tv: права ссылки владелец группа размер месяц день время|год путь
    if out=$(bsdtar -tvf "${a}" ${PASS:+--passphrase "${PASS}"} 2>/dev/null) && [ -n "${out}" ]; then
        awk '{
            t = substr($1, 1, 1) == "d" ? "d" : "f"; s = $5
            # путь — всё после восьмого поля (в нём бывают пробелы)
            line = $0
            for (i = 1; i <= 8; i++) { sub(/^[ \t]*[^ \t]+/, "", line) }
            sub(/^[ \t]/, "", line); sub(/ -> .*$/, "", line)
            if (substr(line, length(line)) == "/") { t = "d"; line = substr(line, 1, length(line) - 1) }
            if (line != "" && line != ".") print t "\t" s "\t" line
        }' <<<"${out}"
        return 0
    fi
    if has 7z; then
        7z l -slt -ba -p"${PASS}" -- "${a}" 2>/dev/null | awk -F' = ' '
            /^Path = / { p = $2 } /^Size = / { s = $2 } /^Attributes = / { t = index($2, "D") ? "d" : "f" }
            /^$/ { if (p != "") print t "\t" (s == "" ? 0 : s) "\t" p; p = ""; s = ""; t = "f" }
            END { if (p != "") print t "\t" (s == "" ? 0 : s) "\t" p }'
        return "${PIPESTATUS[0]}"
    fi
    return 1
}

# --- распаковка ---
need_password() { echo "::password::"; exit 3; }
extract() {
    local a dest smart=0 entries=() total n=0 top code err
    tmp=""  # не local: её убирает trap после выхода из функции
    a=$(realpath -- "$1") || exit 2
    dest=$2; shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            --smart) smart=1 ;;
            --entry) entries+=("$2"); shift ;;
        esac
        shift
    done
    mkdir -p -- "${dest}" || exit 1
    if cmd=$(single "${a}"); then
        local out
        out=$(free_name "${dest}/$(strip_ext "${a}")")
        ${cmd} -- "${a}" >"${out}.part" && mv -- "${out}.part" "${out}" || { rm -f -- "${out}.part"; exit 1; }
        echo "::progress:: 100"
        printf '::done:: %s\n' "${out}"
        return 0
    fi
    # сначала во временную папку рядом: прерванная распаковка не оставит половину
    tmp=$(mktemp -d -p "${dest}" .delta-extract.XXXXXX) || exit 1
    trap 'rm -rf -- "${tmp:?}"' EXIT
    total=$(list_archive "${a}" | wc -l)
    [ "${#entries[@]}" -gt 0 ] && total=${#entries[@]}
    [ "${total}" -gt 0 ] || total=1
    err=$(mktemp)
    # -v пишет каждый файл в stderr («x путь») — по ним и проценты; ошибки там же
    bsdtar -xvf "${a}" -C "${tmp}" ${PASS:+--passphrase "${PASS}"} "${entries[@]}" 2>&1 >/dev/null </dev/null |
        tee "${err}" | while IFS= read -r _; do n=$((n + 1)); p=$((n * 100 / total)); echo "::progress:: $((p > 99 ? 99 : p))"; done
    code=${PIPESTATUS[0]}
    if [ "${code}" -ne 0 ] && has 7z; then
        rm -rf -- "${tmp:?}"/* 2>/dev/null
        7z x -y -bsp1 -bso0 -p"${PASS}" -o"${tmp}" -- "${a}" "${entries[@]}" 2>"${err}" |
            tr '\r\b' '\n\n' | grep -o '[0-9]\+%' --line-buffered | while IFS= read -r p; do echo "::progress:: ${p%\%}"; done
        code=${PIPESTATUS[0]}
    elif [ "${code}" -ne 0 ] && has unrar && case "${a,,}" in *.rar|*.cbr) true ;; *) false ;; esac; then
        rm -rf -- "${tmp:?}"/* 2>/dev/null
        unrar x -o+ -p"${PASS:--}" -- "${a}" "${entries[@]}" "${tmp}/" >/dev/null 2>"${err}"
        code=$?
    fi
    if [ "${code}" -ne 0 ]; then
        if grep -qiE "passphrase|password|encrypt|wrong pass" "${err}"; then rm -f -- "${err}"; need_password; fi
        grep -v '^x ' "${err}" | sed -n '1,3p' >&2
        rm -f -- "${err}"
        exit 1
    fi
    rm -f -- "${err}"
    # что вышло: одна вещь внутри (или --smart не просили) — решаем, куда класть
    mapfile -t top < <(find "${tmp}" -mindepth 1 -maxdepth 1 -printf '%f\n')
    local final
    if [ "${#entries[@]}" -gt 0 ]; then
        # отдельные файлы (открыть из архива) — сами по себе, без папок архива
        local e
        for e in "${entries[@]}"; do
            [ -e "${tmp}/${e}" ] || continue
            final=$(free_name "${dest}/$(basename -- "${e}")")
            mv -- "${tmp}/${e}" "${final}"
        done
    elif [ "${smart}" = 1 ] && [ "${#top[@]}" -eq 1 ]; then
        local t
        for t in "${top[@]}"; do
            final=$(free_name "${dest}/${t}")
            mv -- "${tmp}/${t}" "${final}"
        done
        [ "${#top[@]}" -eq 1 ] || final=${dest}
    else
        final=$(free_name "${dest}/$(strip_ext "${a}")")
        mv -- "${tmp}" "${final}"
        trap - EXIT
    fi
    echo "::progress:: 100"
    printf '::done:: %s\n' "${final}"
}

# --- сжатие ---
compress() {
    local fmt=$1 out=$2 dir=$3 code
    shift 3
    [ $# -gt 0 ] || exit 2
    out=$(free_name "${out}")
    cd -- "${dir}" || exit 1
    case "${fmt}" in
        zip)    bsdtar -a --format zip -cf "${out}.part" -- "$@" ;;
        7z)     if has 7z; then 7z a -bso0 -bsp0 -t7z "${out}.part" -- "$@" >/dev/null; else bsdtar --format 7zip -cf "${out}.part" -- "$@"; fi ;;
        tar.zst) bsdtar --zstd -cf "${out}.part" -- "$@" ;;
        tar.gz) bsdtar -z -cf "${out}.part" -- "$@" ;;
        tar.xz) bsdtar -J -cf "${out}.part" -- "$@" ;;
        *) echo "delta-files: не знаю формат ${fmt}" >&2; exit 2 ;;
    esac
    code=$?
    [ "${code}" -eq 0 ] || { rm -f -- "${out}.part"; exit "${code}"; }
    mv -- "${out}.part" "${out}"
    printf '::done:: %s\n' "${out}"
}

# --- вставка: копия или перенос в <куда>; занятое имя — «имя (2)» ---
paste() {
    local mode=$1 dest=$2 src t code=0
    shift 2
    for src in "$@"; do
        [ -e "${src}" ] || continue
        t="${dest}/$(basename -- "${src}")"
        # в ту же папку: перенос — ничего не делать, копия — рядом с новым именем
        if [ "$(realpath -- "${src}")" = "$(realpath -m -- "${t}")" ]; then
            [ "${mode}" = move ] && continue
        fi
        case "$(realpath -m -- "${dest}")/" in "$(realpath -- "${src}")/"*)
            echo "Нельзя положить папку внутрь неё самой" >&2; code=2; continue ;;
        esac
        t=$(free_name "${t}")
        if [ "${mode}" = move ]; then mv -- "${src}" "${t}" || code=1
        else cp -a --reflink=auto -- "${src}" "${t}" || code=1; fi
    done
    return "${code}"
}

case "${1:-}" in
    -h|--help) sed -n '2,/^set -u/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'; exit 0 ;;
    ipc) shift; exec qs -p "${ENTRY}" ipc "$@" ;;
    --list) [ -f "${2:-}" ] || exit 2; list_archive "$2" ;;
    --extract) [ -f "${2:-}" ] && [ -n "${3:-}" ] || exit 2; extract "${@:2}" ;;
    --compress) [ $# -ge 5 ] || exit 2; compress "${@:2}" ;;
    --is-archive) is_archive "${2:-}" ;;
    --paste) [ $# -ge 4 ] && [ -d "$3" ] || exit 2; paste "${@:2}" ;;
    --*) echo "delta-files: неизвестный ключ $1 (см. --help)" >&2; exit 2 ;;
    *)
        p=${1:-${HOME}}
        # file:// из других программ: %20 и т. п. — обратно в буквы
        case "${p}" in file://*) p=${p#file://}; p=$(printf '%b' "${p//%/\\x}") ;; esac
        p=$(realpath -- "${p}" 2>/dev/null || echo "${HOME}")
        # файл: архив откроется как папка, другой — его папка с ним выделенным
        k=dir; [ -d "${p}" ] || k=file
        DELTA_FILES_OPEN=${p} DELTA_FILES_KIND=${k} exec qs -p "${ENTRY}" -d
        ;;
esac
