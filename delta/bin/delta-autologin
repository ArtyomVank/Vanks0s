#!/usr/bin/env bash
# Delta — автовход через greetd ([initial_session] в /etc/greetd/config.toml).
#
#   delta-autologin status              напечатать пользователя автовхода (или ничего)
#   pkexec delta-autologin enable <user>
#   pkexec delta-autologin disable
#
# Правит только свой блок между метками «delta:autologin» — остальной конфиг
# greetd не трогает. Права даёт polkit (org.vankos.delta.autologin): включить
# автовход можно только себе. Запись атомарная: временный файл и mv.
#
# Проверка без root: DELTA_GREETD_CONFIG=/путь/к/копии delta-autologin …
# (под root переменная игнорируется — pkexec её и не передаёт).
set -euo pipefail

CONF=/etc/greetd/config.toml
if [ "$(id -u)" != 0 ] && [ -n "${DELTA_GREETD_CONFIG:-}" ]; then
    CONF=${DELTA_GREETD_CONFIG}
fi
BEGIN="# delta:autologin:begin — пишет delta-autologin, не редактировать"
END="# delta:autologin:end"

fail() { echo "delta-autologin: $*" >&2; exit 1; }

current() {
    [ -r "${CONF}" ] || return 0
    sed -n "/^# delta:autologin:begin/,/^# delta:autologin:end/s/^user = \"\(.*\)\"$/\1/p" "${CONF}" | head -n1
}

write_block() {
    local user=$1 tmp
    [ -f "${CONF}" ] || fail "нет ${CONF} — экран входа greetd не установлен"
    tmp=$(mktemp "${CONF}.XXXXXX")
    trap 'rm -f "${tmp}"' EXIT
    # убрать прежний блок, затем дописать новый (если нужен)
    sed "/^# delta:autologin:begin/,/^# delta:autologin:end/d" "${CONF}" > "${tmp}"
    if [ -n "${user}" ]; then
        printf '\n%s\n[initial_session]\ncommand = "/usr/bin/delta-session"\nuser = "%s"\n%s\n' \
            "${BEGIN}" "${user}" "${END}" >> "${tmp}"
    fi
    # сжать хвостовые пустые строки, оставшиеся от прежнего блока
    sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "${tmp}"
    chmod --reference="${CONF}" "${tmp}" 2>/dev/null || chmod 0644 "${tmp}"
    mv -f "${tmp}" "${CONF}"
    trap - EXIT
}

case "${1:-}" in
    status)
        current
        ;;
    enable)
        user=${2:-}
        [[ "${user}" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || fail "неверное имя пользователя"
        entry=$(getent passwd "${user}") || fail "нет пользователя ${user}"
        uid=$(cut -d: -f3 <<<"${entry}")
        [ "${uid}" -ge 1000 ] || fail "автовход системного пользователя запрещён"
        # через pkexec — только себе
        if [ -n "${PKEXEC_UID:-}" ] && [ "${PKEXEC_UID}" != "${uid}" ]; then
            fail "включить автовход можно только для своей учётной записи"
        fi
        write_block "${user}"
        echo "автовход: ${user}"
        ;;
    disable)
        write_block ""
        echo "автовход выключен"
        ;;
    *)
        echo "использование: delta-autologin status | enable <пользователь> | disable" >&2
        exit 2
        ;;
esac
