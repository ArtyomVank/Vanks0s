#!/usr/bin/env python3
"""Delta Link — компьютер и телефон (Vanks Launcher) вместе по домашней сети.

  delta-link serve                служба: её запускает оболочка (services/Link.qml),
                                  пока Delta Link включён; события — строки JSON
  delta-link status               телефоны и код привязки (JSON)
  delta-link pair                 новый код привязки на 2 минуты
  delta-link unpair <id>          отвязать телефон
  delta-link send [--to <id>] <файлы…>   отправить файлы на телефон («Загрузки»)
  delta-link ring <id>            найти телефон: он звонит, пока не возьмут
  delta-link clip <id>            отправить буфер обмена на телефон сейчас

Что умеет связка:
  • уведомления телефона приходят на компьютер (звонки — островом);
  • общий буфер обмена в обе стороны (link.clipboard);
  • файлы: с компьютера — «Отправить на телефон», с телефона — «Поделиться →
    Delta Link», они ложатся в «Загрузки»;
  • заряд телефона и «Найти телефон».

Телефон находит компьютер сам: шлёт в сеть широковещательный запрос
(UDP 47821), служба отвечает именем и портом. Привязка — шестизначный код
с экрана компьютера, дальше у телефона свой ключ (~/.config/delta/link.json).
Сервер (HTTP 47820) отвечает только адресам домашней сети и только с ключом.
Команды status/pair/… говорят со службой через сокет в XDG_RUNTIME_DIR.

DELTA_LINK_PORT — другой порт HTTP (UDP — следующий за ним), для проверок.
"""
import base64
import hmac
import ipaddress
import json
import os
import secrets
import shutil
import socket
import socketserver
import subprocess
import sys
import threading
import time
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, quote, unquote, urlparse

PORT = int(os.environ.get("DELTA_LINK_PORT", "47820"))
UDP_PORT = PORT + 1
CFG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "delta")
STORE = os.path.join(CFG_DIR, "link.json")
SETTINGS = os.path.join(CFG_DIR, "settings.json")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "delta", "link")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
SOCK = os.path.join(RUNTIME, f"delta-link-{PORT}.sock")
if len(SOCK.encode()) > 100:      # путь сокета ограничен 108 байтами
    SOCK = f"/tmp/delta-link-{os.getuid()}-{PORT}.sock"
VERSION = 1
PAIR_TTL = 120
ONLINE_FOR = 70          # телефон держит запрос /events до 25 с, потом приходит снова
MAX_UPLOAD = 8 << 30
MAX_CLIP = 256 << 10
# значок уведомлений, пока телефон не прислал значок приложения: окна
# «Телефон» — из пакета или рядом в исходниках
PHONE_ICON = next((p for p in ("/usr/share/icons/hicolor/scalable/apps/delta-phone.svg",
                               os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "session", "delta-phone.svg"))
                   if os.path.isfile(p)), "phone")


def say(**ev):
    """Событие для оболочки — строка JSON в stdout."""
    try:
        print(json.dumps(ev, ensure_ascii=False), flush=True)
    except (BrokenPipeError, ValueError):
        pass


def setting(key, default):
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            cur = json.load(f)
        for part in key.split("."):
            cur = cur[part]
        return cur
    except (OSError, ValueError, KeyError, TypeError):
        return default


def downloads():
    try:
        d = subprocess.run(["xdg-user-dir", "DOWNLOAD"], capture_output=True, text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        d = ""
    d = d if d and d != os.path.expanduser("~") else os.path.expanduser("~/Downloads")
    os.makedirs(d, exist_ok=True)
    return d


def free_name(folder, name):
    name = os.path.basename(name.replace("\\", "/")).strip().lstrip(".") or "file"
    base, ext = os.path.splitext(name)
    path, n = os.path.join(folder, name), 1
    while os.path.exists(path):
        n += 1
        path = os.path.join(folder, f"{base} ({n}){ext}")
    return path


# ---------- хранилище: этот компьютер и его телефоны ----------

class Store:
    def __init__(self):
        self.lock = threading.Lock()
        try:
            with open(STORE, encoding="utf-8") as f:
                self.data = json.load(f)
        except (OSError, ValueError):
            self.data = {}
        self.data.setdefault("id", uuid.uuid4().hex)
        self.data.setdefault("devices", {})
        self.save()

    def save(self):
        os.makedirs(CFG_DIR, exist_ok=True)
        tmp = STORE + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(self.data, f, ensure_ascii=False, indent=1)
        os.replace(tmp, STORE)

    def device_by_token(self, dev, token):
        d = self.data["devices"].get(dev or "")
        if d and token and hmac.compare_digest(d.get("token", ""), token):
            return d
        return None


# ---------- служба ----------

class Link:
    def __init__(self):
        self.store = Store()
        self.lock = threading.Condition()
        self.events = {}        # id телефона -> [события]
        self.seq = 0
        self.live = {}          # id -> {battery, charging, seen, addr}
        self.pair = None        # {code, until, tries}
        self.files = {}         # fid -> путь (для GET /file)
        self.notes = {}         # (id, key) -> номер уведомления на компьютере
        self.last_clip = None
        self.name = socket.gethostname()

    # --- состояние для окна и команд ---
    def status(self):
        now = time.time()
        devs = []
        for did, d in self.store.data["devices"].items():
            lv = self.live.get(did, {})
            devs.append({"id": did, "name": d.get("name", ""), "model": d.get("model", ""),
                         "online": now - lv.get("seen", 0) < ONLINE_FOR,
                         "battery": lv.get("battery", -1), "charging": lv.get("charging", False),
                         "paired": d.get("paired", 0)})
        pair = None
        if self.pair and self.pair["until"] > now:
            pair = {"code": self.pair["code"], "until": self.pair["until"]}
        return {"running": True, "name": self.name, "port": PORT, "devices": devs, "pair": pair}

    def changed(self):
        say(ev="status", **self.status())

    def new_pair(self):
        self.pair = {"code": f"{secrets.randbelow(1000000):06d}", "until": time.time() + PAIR_TTL, "tries": 0}
        self.changed()
        return self.pair["code"]

    def push(self, did, ev):
        with self.lock:
            targets = [did] if did else [k for k in self.store.data["devices"]]
            for t in targets:
                self.seq += 1
                q = self.events.setdefault(t, [])
                q.append(dict(ev, n=self.seq))
                del q[:-50]
            self.lock.notify_all()
        return len(targets)

    def online_ids(self):
        now = time.time()
        return [k for k, v in self.live.items() if now - v.get("seen", 0) < ONLINE_FOR and k in self.store.data["devices"]]

    # --- уведомления телефона на компьютере ---
    def show_note(self, did, body):
        dev = self.store.data["devices"].get(did, {})
        key = str(body.get("key", ""))
        app = str(body.get("app") or "Телефон")[:60]
        title = str(body.get("title") or app)[:200]
        text = str(body.get("text") or "")[:1000]
        call = body.get("call") is True
        if call and setting("link.calls", True) is not False:
            say(ev="call", device=dev.get("name", ""), title=title, text=text)
        if setting("link.notifications", True) is False:
            return
        # значок приложения телефон шлёт один раз — дальше берём из кэша
        icon = PHONE_ICON
        pkg = "".join(c for c in str(body.get("pkg") or "") if c.isalnum() or c in "._-")[:80]
        path = os.path.join(CACHE, pkg + ".png") if pkg else ""
        if path and body.get("icon"):
            os.makedirs(CACHE, exist_ok=True)
            try:
                with open(path, "wb") as f:
                    f.write(base64.b64decode(body["icon"])[:256 << 10])
            except (OSError, ValueError):
                pass
        if path and os.path.isfile(path):
            icon = path
        cmd = ["notify-send", "-p", "-a", f"{app} · {dev.get('name') or 'Телефон'}", "-i", icon,
               "-h", "string:x-delta-link:" + did]
        if call:
            # звонок не дольше минуты: отбой мог не дойти (служба перезапускалась)
            cmd += ["-u", "critical", "-t", "60000", "-h", "string:category:call"]
        old = self.notes.get((did, key))
        if old:
            cmd += ["-r", str(old)]
        try:
            out = subprocess.run(cmd + [title, text], capture_output=True, text=True, timeout=5).stdout.strip()
            if key and out.isdigit():
                self.notes[(did, key)] = int(out)
        except (OSError, subprocess.SubprocessError):
            pass

    def drop_note(self, did, key):
        nid = self.notes.pop((did, str(key)), None)
        if nid:
            subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                            "--object-path", "/org/freedesktop/Notifications",
                            "--method", "org.freedesktop.Notifications.CloseNotification", str(nid)],
                           capture_output=True, timeout=5, check=False)

    # --- буфер обмена ---
    def set_clip(self, text):
        if setting("link.clipboard", True) is False or not isinstance(text, str) or not text:
            return
        self.last_clip = text
        try:
            subprocess.run(["wl-copy", "--", text], timeout=5, check=False)
        except (OSError, subprocess.SubprocessError):
            pass

    def watch_clip(self):
        # каждая смена буфера — строка base64; пароли из менеджеров паролей не шлём
        cmd = ["wl-paste", "-n", "-t", "text", "--watch", "sh", "-c",
               "wl-paste -l 2>/dev/null | grep -q x-kde-passwordManagerHint && { echo; exit 0; }; base64 -w0; echo"]
        while True:
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
            except OSError:
                return
            for line in proc.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    text = base64.b64decode(line).decode("utf-8")
                except (ValueError, UnicodeDecodeError):
                    continue
                if text == self.last_clip or len(text.encode()) > MAX_CLIP:
                    continue
                self.last_clip = text
                if setting("link.clipboard", True) is not False and self.online_ids():
                    self.push(None, {"type": "clip", "text": text})
            proc.wait()
            time.sleep(3)

    # --- поиск в сети ---
    def beacon(self):
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        try:
            sock.bind(("", UDP_PORT))
        except OSError as e:
            say(ev="error", error=f"udp: {e}")
            return
        while True:
            try:
                data, addr = sock.recvfrom(512)
            except OSError:
                continue
            if not data.startswith(b"DELTA-LINK?") or not private(addr[0]):
                continue
            reply = {"delta-link": VERSION, "id": self.store.data["id"], "name": self.name, "port": PORT}
            try:
                sock.sendto(json.dumps(reply).encode(), addr)
            except OSError:
                pass


def private(addr):
    try:
        ip = ipaddress.ip_address(addr)
    except ValueError:
        return False
    if ip.version == 6 and ip.ipv4_mapped:
        ip = ip.ipv4_mapped
    return ip.is_private or ip.is_loopback or ip.is_link_local


# ---------- HTTP для телефона ----------

class Handler(BaseHTTPRequestHandler):
    link: Link = None
    server_version = "DeltaLink/1"
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def reply(self, code, obj=None):
        body = json.dumps(obj if obj is not None else {}, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def body_json(self, limit=4 << 20):
        n = int(self.headers.get("Content-Length") or 0)
        if n <= 0 or n > limit:
            return {}
        try:
            return json.loads(self.rfile.read(n).decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return {}

    def device(self):
        token = (self.headers.get("Authorization") or "").removeprefix("Bearer ").strip()
        did = self.headers.get("X-Link-Device", "")
        if not self.link.store.device_by_token(did, token):
            return None
        lv = self.link.live.setdefault(did, {})
        was = time.time() - lv.get("seen", 0) < ONLINE_FOR
        lv["seen"] = time.time()
        lv["addr"] = self.client_address[0]
        if not was:
            self.link.changed()
        return did

    def allowed(self):
        if private(self.client_address[0]):
            return True
        self.reply(403, {"error": "lan-only"})
        return False

    def do_GET(self):
        if not self.allowed():
            return
        url = urlparse(self.path)
        if url.path == "/info":
            return self.reply(200, {"delta-link": VERSION, "id": self.link.store.data["id"], "name": self.link.name})
        did = self.device()
        if not did:
            return self.reply(401, {"error": "auth"})
        if url.path == "/events":
            try:
                after = int((parse_qs(url.query).get("after") or ["0"])[0] or 0)
            except ValueError:
                after = 0
            # -1 — только что привязали: старое не нужно; больше номера служба
            # — она перезапускалась, номера начались заново
            if after < 0:
                return self.reply(200, {"events": [], "next": self.link.seq})
            if after > self.link.seq:
                after = 0
            deadline = time.time() + 25
            with self.link.lock:
                while True:
                    q = [e for e in self.link.events.get(did, []) if e["n"] > after]
                    if q or time.time() >= deadline or did not in self.link.store.data["devices"]:
                        break
                    self.link.lock.wait(deadline - time.time())
            if did not in self.link.store.data["devices"]:
                return self.reply(200, {"events": [{"n": 0, "type": "unpaired"}], "next": after})
            return self.reply(200, {"events": q, "next": max([after] + [e["n"] for e in q])})
        if url.path.startswith("/file/"):
            path = self.link.files.get(url.path[6:])
            if not path or not os.path.isfile(path):
                return self.reply(404, {"error": "gone"})
            size = os.path.getsize(path)
            self.send_response(200)
            self.send_header("Content-Type", "application/octet-stream")
            self.send_header("Content-Length", str(size))
            self.send_header("Content-Disposition", "attachment; filename*=UTF-8''" + quote(os.path.basename(path), safe=""))
            self.end_headers()
            with open(path, "rb") as f:
                shutil.copyfileobj(f, self.wfile, 1 << 20)
            return None
        return self.reply(404, {"error": "path"})

    def do_POST(self):
        if not self.allowed():
            return
        url = urlparse(self.path)
        link = self.link
        if url.path == "/pair":
            body = self.body_json()
            p = link.pair
            if not p or p["until"] < time.time():
                return self.reply(403, {"error": "no-code"})
            p["tries"] += 1
            if p["tries"] > 5:
                link.pair = None
                link.changed()
                return self.reply(403, {"error": "tries"})
            if not hmac.compare_digest(str(body.get("code", "")), p["code"]):
                return self.reply(403, {"error": "code"})
            did = "".join(c for c in str(body.get("id") or uuid.uuid4().hex) if c.isalnum())[:40] or uuid.uuid4().hex
            token = secrets.token_urlsafe(32)
            with link.store.lock:
                link.store.data["devices"][did] = {"name": str(body.get("name") or "Телефон")[:60],
                                                   "model": str(body.get("model") or "")[:60],
                                                   "token": token, "paired": int(time.time())}
                link.store.save()
            link.pair = None
            link.live[did] = {"seen": time.time(), "addr": self.client_address[0]}
            say(ev="paired", id=did, name=link.store.data["devices"][did]["name"])
            link.changed()
            return self.reply(200, {"token": token, "device": did, "pc": {"id": link.store.data["id"], "name": link.name}})
        did = self.device()
        if not did:
            return self.reply(401, {"error": "auth"})
        if url.path == "/upload":
            name = unquote(self.headers.get("X-Name") or "file")
            n = int(self.headers.get("Content-Length") or 0)
            if n <= 0 or n > MAX_UPLOAD:
                self.close_connection = True
                return self.reply(413, {"error": "size"})
            folder = downloads()
            target = free_name(folder, name)
            part = target + ".part"
            left = n
            try:
                with open(part, "wb") as f:
                    while left > 0:
                        chunk = self.rfile.read(min(left, 1 << 20))
                        if not chunk:
                            break
                        f.write(chunk)
                        left -= len(chunk)
                if left:
                    raise OSError("обрыв")
                os.replace(part, target)
            except OSError:
                try:
                    os.unlink(part)
                except OSError:
                    pass
                self.close_connection = True
                return self.reply(500, {"error": "write"})
            dev = link.store.data["devices"].get(did, {})
            say(ev="received", device=dev.get("name", ""), name=os.path.basename(target), path=target, size=n)
            return self.reply(200, {"ok": True, "name": os.path.basename(target)})
        body = self.body_json()
        if url.path == "/hello":
            lv = link.live.setdefault(did, {})
            old = (lv.get("battery"), lv.get("charging"))
            lv["battery"] = int(body.get("battery", -1)) if str(body.get("battery", "")).lstrip("-").isdigit() else -1
            lv["charging"] = body.get("charging") is True
            if (lv["battery"], lv["charging"]) != old:
                link.changed()
            return self.reply(200, {"ok": True, "name": link.name, "clipboard": setting("link.clipboard", True) is not False})
        if url.path == "/notify":
            link.show_note(did, body)
            return self.reply(200, {"ok": True})
        if url.path == "/notify-removed":
            link.drop_note(did, body.get("key", ""))
            return self.reply(200, {"ok": True})
        if url.path == "/clip":
            link.set_clip(body.get("text"))
            return self.reply(200, {"ok": True})
        return self.reply(404, {"error": "path"})


# ---------- команды через сокет ----------

class Control(socketserver.StreamRequestHandler):
    link: Link = None

    def handle(self):
        try:
            req = json.loads(self.rfile.readline().decode("utf-8") or "{}")
        except ValueError:
            req = {}
        link = self.link
        cmd = req.get("cmd")
        out = {"ok": True}
        if cmd == "status":
            out = link.status()
        elif cmd == "pair":
            out = {"code": link.new_pair(), "ttl": PAIR_TTL}
        elif cmd == "unpair":
            did = str(req.get("id", ""))
            with link.store.lock:
                gone = link.store.data["devices"].pop(did, None)
                link.store.save()
            link.live.pop(did, None)
            with link.lock:
                link.lock.notify_all()
            link.changed()
            out = {"ok": gone is not None}
        elif cmd == "send":
            n = 0
            for p in req.get("files", []):
                if isinstance(p, str) and os.path.isfile(p):
                    fid = secrets.token_urlsafe(12)
                    link.files[fid] = p
                    n = link.push(req.get("to"), {"type": "file", "fid": fid, "name": os.path.basename(p),
                                                  "size": os.path.getsize(p)})
            out = {"ok": n > 0, "devices": n}
        elif cmd == "ring":
            out = {"ok": link.push(req.get("to"), {"type": "ring"}) > 0}
        elif cmd == "clip":
            text = subprocess.run(["wl-paste", "-n", "-t", "text"], capture_output=True, text=True, timeout=5).stdout
            out = {"ok": bool(text) and link.push(req.get("to"), {"type": "clip", "text": text[:MAX_CLIP]}) > 0}
        else:
            out = {"ok": False, "error": "cmd"}
        self.wfile.write((json.dumps(out, ensure_ascii=False) + "\n").encode())


def serve():
    link = Link()
    Handler.link = link
    Control.link = link
    try:
        http = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    except OSError as e:
        say(ev="error", error=f"http: {e}")
        return 1
    http.daemon_threads = True
    # оборванные и чужие запросы не печатаем: stdout читает оболочка, stderr — журнал
    http.handle_error = lambda *a: None
    try:
        os.unlink(SOCK)
    except OSError:
        pass
    ctl = socketserver.ThreadingUnixStreamServer(SOCK, Control)
    ctl.daemon_threads = True
    os.chmod(SOCK, 0o600)
    for fn in (http.serve_forever, ctl.serve_forever, link.beacon, link.watch_clip):
        threading.Thread(target=fn, daemon=True).start()
    say(ev="ready", port=PORT, id=link.store.data["id"], name=link.name)
    link.changed()
    # оболочка закрыла stdin — служба больше не нужна
    try:
        for _ in sys.stdin:
            pass
    except KeyboardInterrupt:
        pass
    http.shutdown()
    ctl.shutdown()
    try:
        os.unlink(SOCK)
    except OSError:
        pass
    return 0


def ask(req):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(10)
        s.connect(SOCK)
        s.sendall((json.dumps(req) + "\n").encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
        return json.loads(data.decode("utf-8") or "{}")
    except (OSError, ValueError):
        return None


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd in ("-h", "--help", ""):
        print(__doc__)
        return 0
    if cmd == "serve":
        return serve()
    if cmd == "status":
        out = ask({"cmd": "status"})
        if out is None:
            try:
                with open(STORE, encoding="utf-8") as f:
                    devs = json.load(f).get("devices", {})
            except (OSError, ValueError):
                devs = {}
            out = {"running": False, "devices": [{"id": k, "name": v.get("name", ""), "model": v.get("model", ""),
                                                   "online": False, "battery": -1, "charging": False}
                                                  for k, v in devs.items()], "pair": None}
        print(json.dumps(out, ensure_ascii=False))
        return 0
    req = None
    if cmd == "pair":
        req = {"cmd": "pair"}
    elif cmd == "unpair" and len(argv) > 2:
        req = {"cmd": "unpair", "id": argv[2]}
    elif cmd == "ring" and len(argv) > 2:
        req = {"cmd": "ring", "to": argv[2]}
    elif cmd == "clip" and len(argv) > 2:
        req = {"cmd": "clip", "to": argv[2]}
    elif cmd == "send":
        rest, to = argv[2:], None
        if rest[:1] == ["--to"] and len(rest) > 1:
            to, rest = rest[1], rest[2:]
        req = {"cmd": "send", "to": to, "files": [os.path.abspath(p) for p in rest]}
    if req is None:
        print(__doc__, file=sys.stderr)
        return 2
    out = ask(req)
    if out is None:
        print("delta-link: служба не запущена — включите Delta Link в «Настройках»", file=sys.stderr)
        return 1
    print(json.dumps(out, ensure_ascii=False))
    return 0 if out.get("ok", True) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
