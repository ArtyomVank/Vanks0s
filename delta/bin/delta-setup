#!/usr/bin/env bash
# Delta — установка рекомендованного из помощника «Добро пожаловать»
# (delta-welcome): библиотеки для игр, драйвер видеокарты, приложения.
#
#   delta-setup detect           видеокарты и ядра (без root, систему не меняет):
#                                gpu<TAB>nvidia|amd|intel|vm|other<TAB>0xDEVICE<TAB>название
#                                kernel<TAB>linux-zen …  (установленные ядра)
#                                multilib<TAB>on|off
#   delta-setup install <пакеты> [--aur <pkgbase>…]
#                                поставить (root; помощник зовёт через pkexec,
#                                пароль спрашивает окно polkit оболочки)
#
#   delta-setup remove <пакеты>  удалить (root; зовёт магазин Delta через pkexec)
#   delta-setup protected        пакеты, которые удалять нельзя (по одному в строке)
#
#   delta-setup performance status
#                                on | off | unsupported (без root)
#   delta-setup performance on|off
#                                максимальная производительность (root): процессор
#                                всегда на полной частоте, и после перезагрузки
#
# --aur — только драйвер NVIDIA 580 для GTX 900/1000 (в Arch его больше нет):
# рецепт берётся с aur.archlinux.org, собирается от nobody и ставится pacman -U.
#
# install печатает для помощника строки-метки, остальное — вывод pacman:
#   ::step:: <текст>   начался этап
#   ::reboot::         поставили ядро или драйвер — нужна перезагрузка
#
# Ставим всегда через pacman -Syu: -Sy без -u с последующим -S — частичное
# обновление, которое в Arch ломает систему.
set -u
export LC_ALL=C

LOCK=/var/lib/pacman/db.lck
LOG=/var/log/delta-setup.log
PACMAN_CONF=/etc/pacman.conf
GRUB_DEFAULTS=/etc/default/grub
# после их установки нужна перезагрузка
REBOOT_PKGS=(linux-zen nvidia-open-dkms nvidia-utils nvidia-580xx-dkms mesa vulkan-radeon vulkan-intel vulkan-nouveau)
# что можно собрать из AUR: pkgbase -> пакеты, которые из него ставим
declare -A AUR_PKGS=(
    [nvidia-580xx-utils]="nvidia-580xx-utils nvidia-580xx-dkms"
    [lib32-nvidia-580xx-utils]="lib32-nvidia-580xx-utils"
)

say()  { printf '%s\n' "$*" 2>/dev/null || true; [ -w "${LOG}" ] && printf '%s\n' "$*" >>"${LOG}"; return 0; }
step() { say "::step:: $*"; }
# к своему тексту — причина от pacman (окно показывает последнюю строку stderr)
die()  {
    local m=$* e
    e=$(pacman_error)
    [ -n "${e}" ] && m="${m}: ${e}"
    printf '%s\n' "${m}" >&2 2>/dev/null; [ -w "${LOG}" ] && printf 'ОШИБКА: %s\n' "${m}" >>"${LOG}"; exit 1
}
run()  {
    "$@" 2>&1 | while IFS= read -r line; do say "${line}"; done
    return "${PIPESTATUS[0]}"
}

# Очередь установок. Delta ставит пакеты из помощника, «Рекомендаций»,
# «Обновлений» и лаунчера — второе окно не должно падать с «pacman занят»:
# установки Delta ждут друг друга (flock), а чужой pacman (терминал,
# магазин через libalpm) узнаём по открытому файлу замка, а не по имени
# процесса, и тоже ждём. Замок без хозяина (выключили питание, убили
# процесс) убираем — только его.
QUEUE=/run/delta-packages.lock
WAIT_MAX=1800   # полчаса: обновление системы на медленной сети идёт долго

lock_holder() {  # кто держит замок pacman: имя процесса или пусто
    local fd pid
    fd=$(find /proc/[0-9]*/fd -maxdepth 1 -lname "${LOCK}" -print -quit 2>/dev/null)
    if [ -n "${fd}" ]; then
        pid=${fd#/proc/}; pid=${pid%%/*}
        cat "/proc/${pid}/comm" 2>/dev/null || echo pacman
        return 0
    fi
    pgrep -x pacman >/dev/null && { echo pacman; return 0; }
    return 1
}

wait_turn() {
    exec 9>"${QUEUE}"
    if ! flock -n 9; then
        step "Жду, пока закончится другая установка"
        flock -w "${WAIT_MAX}" 9 || die "Другая установка идёт больше получаса — попробуйте позже"
    fi
    local who waited=0
    while [ -e "${LOCK}" ] && who=$(lock_holder); do
        [ "${waited}" = 0 ] && step "Жду, пока ${who} закончит работу с пакетами"
        sleep 2; waited=$((waited + 2))
        [ "${waited}" -lt "${WAIT_MAX}" ] || die "${who} занят пакетами больше получаса — закройте его и попробуйте снова"
    done
    if [ -e "${LOCK}" ]; then
        say "убираю оставшийся замок базы пакетов ${LOCK}"
        rm -f "${LOCK}"
    fi
}

# последняя ошибка pacman из журнала — её и показываем вместо «не удалось»
pacman_error() {
    [ -r "${LOG}" ] || return 0
    grep -E '^error: ' "${LOG}" | tail -n1 | sed 's/^error: //'
}

cmd_detect() {
    local dev cls vendor device kind name
    for dev in /sys/bus/pci/devices/*; do
        cls=$(cat "${dev}/class" 2>/dev/null) || continue
        # 0x03xxxx — видеоадаптеры (VGA, 3D, дисплейные)
        [[ ${cls} == 0x03* ]] || continue
        vendor=$(cat "${dev}/vendor"); device=$(cat "${dev}/device")
        case ${vendor} in
            0x10de) kind=nvidia ;;
            0x1002) kind=amd ;;
            0x8086) kind=intel ;;
            0x1af4|0x15ad|0x1234|0x80ee|0x1414) kind=vm ;;
            *) kind=other ;;
        esac
        name=""
        command -v lspci >/dev/null && name=$(lspci -vmm -s "${dev##*/}" 2>/dev/null | sed -n 's/^Device:\t//p' | head -n1)
        printf 'gpu\t%s\t%s\t%s\n' "${kind}" "${device}" "${name:-${kind}}"
    done
    printf 'kernel\t%s\n' "$(pacman -Qq linux linux-zen linux-lts linux-hardened 2>/dev/null | tr '\n' ' ')"
    if grep -q '^\[multilib\]' "${PACMAN_CONF}" 2>/dev/null; then echo $'multilib\ton'; else echo $'multilib\toff'; fi
}

# [multilib] нужен для Steam, Wine и lib32-драйверов. В системах до 0.3 его нет.
enable_multilib() {
    grep -q '^\[multilib\]' "${PACMAN_CONF}" && return 0
    step "Включаю 32-битные библиотеки (multilib)"
    cp -a "${PACMAN_CONF}" "${PACMAN_CONF}.delta-setup.bak"
    if grep -q '^#\[multilib\]' "${PACMAN_CONF}"; then
        # закомментированный блок из стандартного pacman.conf
        sed -i '/^#\[multilib\]/{s/^#//;n;s/^#//}' "${PACMAN_CONF}"
    else
        printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >>"${PACMAN_CONF}"
    fi
}

# linux-zen рядом со старым linux: GRUB по умолчанию грузит игровое ядро
grub_prefer_zen() {
    [ -f /boot/vmlinuz-linux-zen ] && [ -f "${GRUB_DEFAULTS}" ] || return 0
    command -v grub-mkconfig >/dev/null || return 0
    step "Делаю игровое ядро основным"
    if grep -q '^#\?GRUB_TOP_LEVEL=' "${GRUB_DEFAULTS}"; then
        sed -i 's|^#\?GRUB_TOP_LEVEL=.*|GRUB_TOP_LEVEL="/boot/vmlinuz-linux-zen"|' "${GRUB_DEFAULTS}"
    else
        echo 'GRUB_TOP_LEVEL="/boot/vmlinuz-linux-zen"' >>"${GRUB_DEFAULTS}"
    fi
    run grub-mkconfig -o /boot/grub/grub.cfg || say "предупреждение: grub-mkconfig не сработал — ядро можно выбрать в меню загрузки"
}

# Драйвер NVIDIA: nouveau не должен попасть в initramfs раньше него
nvidia_initramfs() {
    step "Готовлю загрузку с драйвером NVIDIA"
    sed -i -E '/^HOOKS=/s/ kms( |\))/\1/' /etc/mkinitcpio.conf
    run mkinitcpio -P || say "предупреждение: mkinitcpio завершился с ошибкой"
}

# сборка из AUR от nobody: makepkg от root не работает, и так рецепт не
# получает прав на систему; собранное ставит pacman -U
aur_install() {
    local tmp base pkg files=() f
    tmp=$(mktemp -d /var/tmp/delta-aur.XXXXXX) || die "Нет места для сборки"
    # shellcheck disable=SC2064
    trap "rm -rf '${tmp}'" EXIT
    chown nobody: "${tmp}"
    for base in "$@"; do
        step "Скачиваю рецепт ${base} из AUR"
        curl -fsSL --retry 3 --max-time 60 "https://aur.archlinux.org/cgit/aur.git/snapshot/${base}.tar.gz" \
            | runuser -u nobody -- tar xz -C "${tmp}" || die "Не удалось скачать ${base} из AUR"
        step "Собираю ${base} (несколько минут)"
        ( cd "${tmp}/${base}" && run runuser -u nobody -- env HOME="${tmp}" PKGDEST="${tmp}/out" \
            SRCDEST="${tmp}/src" BUILDDIR="${tmp}/build" makepkg --nodeps --noconfirm ) \
            || die "Не удалось собрать ${base}"
        for pkg in ${AUR_PKGS[${base}]}; do
            f=$(find "${tmp}/out" -maxdepth 1 -name "${pkg}-[0-9]*.pkg.tar.zst" | head -n1)
            [ -n "${f}" ] || die "После сборки ${base} нет пакета ${pkg}"
            files+=("${f}")
        done
        # lib32-… требует nvidia-…-utils той же версии: ставим по очереди
        run pacman -U --needed --noconfirm "${files[@]}" || die "Не удалось установить ${base}"
        files=()
    done
}

# для дока загрузок: «::download:: скачано всего». Скачанное видно по росту кэша
# пакетов (там и готовые пакеты, и недокачанные .part), всё — по сумме размеров
# из pacman. Строки идут только с --progress: другие окна показывают вывод как есть.
download_progress() {
    local total start now
    total=$(pacman -Sup --needed --print-format %s "$@" 2>/dev/null | awk '{ s += $1 } END { printf "%d", s }')
    [ "${total:-0}" -gt 0 ] || return 0
    start=$(du -sb /var/cache/pacman/pkg 2>/dev/null | cut -f1)
    while sleep 1; do
        now=$(du -sb /var/cache/pacman/pkg 2>/dev/null | cut -f1)
        now=$(( now - start ))
        [ "${now}" -gt 0 ] || now=0
        [ "${now}" -lt "${total}" ] || now=${total}
        printf '::download:: %s %s\n' "${now}" "${total}"
    done
}

cmd_install() {
    [ "$(id -u)" = 0 ] || die "нужны права администратора: pkexec delta-setup install …"
    local p pkgs=() aur=() in_aur=0 progress=0
    for p in "$@"; do
        [ "${p}" = --aur ] && { in_aur=1; continue; }
        [ "${p}" = --progress ] && { progress=1; continue; }
        # только имена пакетов: никаких ключей pacman и путей
        [[ ${p} =~ ^[a-z0-9][a-z0-9@._+-]*$ ]] || die "странное имя пакета: ${p}"
        if [ "${in_aur}" = 1 ]; then
            [ -n "${AUR_PKGS[${p}]:-}" ] || die "${p} нельзя ставить из AUR"
            aur+=("${p}")
        else
            pkgs+=("${p}")
        fi
    done
    [ $((${#pkgs[@]} + ${#aur[@]})) -gt 0 ] || die "не выбрано, что ставить"
    # сборке из AUR нужны makepkg и dkms
    [ "${#aur[@]}" -gt 0 ] && pkgs+=(base-devel dkms)
    set -- "${pkgs[@]}"
    # окно закрыли — установку не прерываем (pacman, убитый посреди
    # транзакции, оставил бы систему наполовину обновлённой)
    trap '' HUP PIPE
    : >"${LOG}" 2>/dev/null
    wait_turn

    local before after
    before=$(pacman -Q "${REBOOT_PKGS[@]}" 2>/dev/null)

    enable_multilib || die "Не удалось включить multilib в ${PACMAN_CONF}"
    step "Обновляю ключи подписи"
    run pacman -Sy --needed --noconfirm archlinux-keyring || die "Не удалось получить списки пакетов — нет интернета?"
    step "Скачиваю и устанавливаю (${#} пакетов)"
    local dl=""
    if [ "${progress}" = 1 ]; then download_progress "$@" & dl=$!; fi
    run pacman -Su --needed --noconfirm "$@"
    local rc=$?
    [ -n "${dl}" ] && kill "${dl}" 2>/dev/null
    [ "${rc}" = 0 ] || die "Установка не удалась"
    [ "${#aur[@]}" -gt 0 ] && aur_install "${aur[@]}"

    if printf '%s\n' "$@" | grep -qx linux-zen; then grub_prefer_zen; fi
    if [ "${#aur[@]}" -gt 0 ] || printf '%s\n' "$@" | grep -qx nvidia-open-dkms; then nvidia_initramfs; fi
    if printf '%s\n' "$@" | grep -qx flatpak; then
        step "Подключаю Flathub"
        run flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
            || say "предупреждение: Flathub не подключился — магазин покажет только пакеты Arch"
    fi

    after=$(pacman -Q "${REBOOT_PKGS[@]}" 2>/dev/null)
    [ "${before}" != "${after}" ] && say "::reboot::"
    step "Готово"
}

# удаление из магазина Delta (delta-store): пакет с зависимостями, которые
# больше никому не нужны (-Rns). То, без чего не работает система или Delta,
# не трогаем; нужное другим пакетам pacman не удалит сам.
PROTECTED=(delta base linux linux-zen linux-lts linux-firmware systemd pacman sudo grub efibootmgr
    hyprland quickshell greetd mesa networkmanager pipewire wireplumber polkit flatpak)
cmd_remove() {
    [ "$(id -u)" = 0 ] || die "нужны права администратора: pkexec delta-setup remove …"
    local p q
    for p in "$@"; do
        [[ ${p} =~ ^[a-z0-9][a-z0-9@._+-]*$ ]] || die "странное имя пакета: ${p}"
        for q in "${PROTECTED[@]}"; do [ "${p}" = "${q}" ] && die "${p} нужен системе — его удалять нельзя"; done
    done
    [ "$#" -gt 0 ] || die "не выбрано, что удалять"
    trap '' HUP PIPE
    : >"${LOG}" 2>/dev/null
    wait_turn
    step "Удаляю ${*}"
    run pacman -Rns --noconfirm "$@" || die "Удалить не получилось"
    step "Готово"
}

# Режимы производительности (Настройки → Производительность):
#   eco          без турбо и с самым бережным регулятором частоты;
#   balance      обычный режим: частота идёт за нагрузкой;
#   performance  все ядра всегда на максимальной частоте (минимум = максимум).
# Режим лежит в PERF_STATE, служба delta-performance повторяет его при загрузке
# (balance — обычное состояние системы, для него службы нет). power-profiles-daemon
# переключаем первым, иначе он вернёт свой режим. DELTA_SETUP_ROOT — для проверок.
PERF_ROOT=${DELTA_SETUP_ROOT:-}
PERF_STATE=${PERF_ROOT}/var/lib/delta/performance
# правило прежних версий (тумблер «Максимальная производительность»)
PERF_RULE=${PERF_ROOT}/etc/tmpfiles.d/delta-performance.conf
PERF_CPU=${PERF_ROOT}/sys/devices/system/cpu
PERF_POLICIES=${PERF_CPU}/cpufreq
perf_write() {  # файл значение: драйвер может отказать (EPP при performance) — не страшно
    [ -w "$1" ] && { printf '%s\n' "$2" >"$1"; } 2>/dev/null
    return 0
}
perf_supported() {
    local p
    for p in "${PERF_POLICIES}"/policy*/scaling_governor; do
        [ -r "${p}" ] && return 0
    done
    return 1
}
perf_mode() {
    perf_supported || { echo unsupported; return 0; }
    local m=""
    [ -r "${PERF_STATE}" ] && m=$(cat "${PERF_STATE}")
    case "${m}" in
        eco|balance|performance) echo "${m}" ;;
        *) if [ -e "${PERF_RULE}" ]; then echo performance; else echo balance; fi ;;
    esac
}
perf_governor() {  # каталог_политики регуляторы…: первый, какой есть у драйвера
    local p=$1 gov
    shift
    for gov in "$@"; do
        if grep -qw "${gov}" "${p}/scaling_available_governors" 2>/dev/null; then
            perf_write "${p}/scaling_governor" "${gov}"
            return 0
        fi
    done
}
perf_apply() {
    local mode=$1 p min max turbo=1
    [ "${mode}" = eco ] && turbo=0
    # no_turbo и boost до чтения частот: без турбо меняется и cpuinfo_max_freq
    perf_write "${PERF_CPU}/intel_pstate/no_turbo" "$((1 - turbo))"
    perf_write "${PERF_POLICIES}/boost" "${turbo}"
    for p in "${PERF_POLICIES}"/policy*; do
        [ -d "${p}" ] || continue
        perf_write "${p}/boost" "${turbo}"
        min=$(cat "${p}/cpuinfo_min_freq" 2>/dev/null)
        max=$(cat "${p}/cpuinfo_max_freq" 2>/dev/null)
        case "${mode}" in
            performance)
                perf_governor "${p}" performance
                perf_write "${p}/energy_performance_preference" performance
                # минимум поднимаем после максимума: драйвер не примет min > max
                [ -n "${max}" ] && perf_write "${p}/scaling_max_freq" "${max}"
                [ -n "${max}" ] && perf_write "${p}/scaling_min_freq" "${max}"
                ;;
            balance|eco)
                # у пассивных драйверов powersave — это всегда самая низкая частота,
                # поэтому он последний: остаётся только там, где выбирать не из чего
                if [ "${mode}" = eco ]; then
                    perf_governor "${p}" conservative schedutil ondemand powersave
                    perf_write "${p}/energy_performance_preference" power
                else
                    perf_governor "${p}" schedutil ondemand powersave
                    perf_write "${p}/energy_performance_preference" balance_performance
                fi
                [ -n "${min}" ] && perf_write "${p}/scaling_min_freq" "${min}"
                [ -n "${max}" ] && perf_write "${p}/scaling_max_freq" "${max}"
                ;;
        esac
    done
}
perf_info() {  # ядер, средняя, самая низкая и самая высокая частота сейчас (МГц)
    local f v n=0 sum=0 lo=0 hi=0
    for f in "${PERF_CPU}"/cpu[0-9]*/cpufreq/scaling_cur_freq; do
        [ -r "${f}" ] || continue
        v=$(($(cat "${f}") / 1000))
        n=$((n + 1)); sum=$((sum + v))
        { [ "${lo}" = 0 ] || [ "${v}" -lt "${lo}" ]; } && lo=${v}
        [ "${v}" -gt "${hi}" ] && hi=${v}
    done
    [ "${n}" -gt 0 ] && echo "${n} $((sum / n)) ${lo} ${hi}"
    return 0
}
cmd_performance() {
    local mode=${1:-}
    case "${mode}" in
        mode) perf_mode; return 0 ;;
        info) perf_info; return 0 ;;
        # для тумблера в «Рекомендациях»
        status)
            case "$(perf_mode)" in
                unsupported) echo unsupported ;;
                performance) echo on ;;
                *) echo off ;;
            esac
            return 0 ;;
        on) mode=performance ;;
        off) mode=balance ;;
    esac
    [ -n "${PERF_ROOT}" ] || [ "$(id -u)" = 0 ] || die "нужны права администратора: pkexec delta-setup performance …"
    perf_supported || die "Частотой этого процессора система не управляет"
    local ppd=""
    case "${mode}" in
        eco) ppd=power-saver ;;
        balance) ppd=balanced ;;
        performance) ppd=performance ;;
        # при загрузке (служба delta-performance)
        apply)
            mode=$(perf_mode)
            [ "${mode}" = balance ] && return 0
            perf_apply "${mode}"
            return 0 ;;
        *) die "performance: eco | balance | performance | apply | mode | info" ;;
    esac
    mkdir -p "$(dirname -- "${PERF_STATE}")" || die "Не удалось сохранить режим"
    printf '%s\n' "${mode}" >"${PERF_STATE}" || die "Не удалось сохранить режим"
    rm -f "${PERF_RULE}"
    if [ -z "${PERF_ROOT}" ]; then
        command -v powerprofilesctl >/dev/null && powerprofilesctl set "${ppd}" >/dev/null 2>&1
        if [ "${mode}" = balance ]; then
            systemctl disable delta-performance.service >/dev/null 2>&1
        else
            systemctl enable delta-performance.service >/dev/null 2>&1
        fi
    fi
    perf_apply "${mode}"
    return 0
}

case "${1:-}" in
    detect) cmd_detect ;;
    performance) shift; cmd_performance "$@" ;;
    install) shift; cmd_install "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    protected) printf '%s\n' "${PROTECTED[@]}" ;;
    -h|--help|"")
        sed -n '2,/^set -u/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'
        [ -n "${1:-}" ] || exit 2
        ;;
    *) die "неизвестная команда: $1 (detect | install | remove | performance)" ;;
esac
